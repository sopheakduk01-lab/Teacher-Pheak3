{
  "entities": {
    "book": {
      "title": "Book",
      "description": "A book in the library",
      "type": "object",
      "properties": {
        "title": { "type": "string", "description": "Title of the book" },
        "author": { "type": "string", "description": "Author of the book" },
        "isbn": { "type": "string", "description": "ISBN of the book" },
        "status": { "type": "string", "enum": ["available", "borrowed"], "description": "Status of the book" }
      },
      "required": ["title", "status"]
    },
    "borrowing_record": {
      "title": "Borrowing Record",
      "description": "Record of a book borrowing event",
      "type": "object",
      "properties": {
        "bookId": { "type": "string", "description": "ID of the borrowed book" },
        "borrowerName": { "type": "string", "description": "Name of the borrower" },
        "borrowDate": { "type": "string", "format": "date", "description": "Date of borrowing" },
        "dueDate": { "type": "string", "format": "date", "description": "Due date for return" },
        "returnDate": { "type": "string", "format": "date", "description": "Actual return date" }
      },
      "required": ["bookId", "borrowerName", "borrowDate", "dueDate"]
    }
  },
  "firestore": {
    "books": {
      "schema": "book",
      "description": "Collection of library books"
    },
    "borrowing_records": {
      "schema": "borrowing_record",
      "description": "Collection of borrowing records"
    }
  }
}
