{
  "entities": {
    "TeacherYearBundle": {
      "title": "Teacher Year Bundle",
      "description": "Stores all students, attendance, grades, logbook, inventory, and quizzes for an academic year",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "The user ID of the teacher"
        },
        "year": {
          "type": "string",
          "description": "The academic year identifier (e.g. 2025-2026)"
        },
        "teacher": {
          "type": "object",
          "description": "Teacher profile information"
        },
        "students": {
          "type": "array",
          "description": "Array of student records"
        },
        "attendance": {
          "type": "object",
          "description": "Monthly attendance database"
        },
        "grades": {
          "type": "object",
          "description": "Monthly grades database"
        },
        "logbook": {
          "type": "array",
          "description": "Daily teaching logbook and lesson records"
        },
        "inventory": {
          "type": "array",
          "description": "Classroom materials and inventory list"
        },
        "plc": {
          "type": "array",
          "description": "Professional Learning Community meetings"
        },
        "quizzes": {
          "type": "array",
          "description": "Quiz questions and interactive games"
        },
        "libraryBooks": {
          "type": "array",
          "description": "Library books repository"
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO timestamp of last update"
        }
      },
      "required": ["userId", "year"]
    }
  },
  "firestore": {
    "/teachers/{userId}/years/{yearId}": {
      "schema": "TeacherYearBundle",
      "description": "Contains teacher academic data for a specific year"
    }
  }
}
