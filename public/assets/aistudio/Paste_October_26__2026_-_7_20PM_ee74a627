        function useFreezeSkill() {
            if (skillInventory.freeze <= 0 || isTimerFrozen || isAnsweringBlocked) return;
            skillInventory.freeze--;
            isTimerFrozen = true;
            updateSkillBadges();
            playSoundFx('freeze');

            const timerText = document.getElementById('timer-text');
            timerText.classList.add('frozen-timer');
            timerText.innerText = "❄️ ផ្អាក!";

