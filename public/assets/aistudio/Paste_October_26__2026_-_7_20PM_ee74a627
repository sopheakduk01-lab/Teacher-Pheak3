                btn.innerHTML = `
                    <div class="flex items-center gap-2">
                        <span class="w-6 h-6 sm:w-7 sm:h-7 rounded-lg bg-amber-400/20 text-amber-300 border border-amber-400/40 flex items-center justify-center font-black text-xs sm:text-sm">${prefixes[idx]}</span>
                        <span class="choice-text tracking-wide">${choice}</span>
                    </div>
                    <span class="text-slate-500 text-xs">🏹</span>
                `;
                btn.onclick = () => handleAnswer(idx);
                grid.appendChild(btn);
            });

            // Start Question Countdown Timer
            timer = 30 + (activeHero.bonusTimer || 0);
            updateTimerDisplay();

            timerInterval = setInterval(() => {
                if (isGamePaused || isTimerFrozen) return;
                timer--;
                updateTimerDisplay();

                if (timer <= 5 && timer > 0) {
                    playSoundFx('tick');
                }

                if (timer <= 0) {
                    clearInterval(timerInterval);
                    handleAnswer(-1); // Timeout
                }
            }, 1000);
        }

        function updateTimerDisplay() {
            if (isTimerFrozen) return;
            const timerText = document.getElementById('timer-text');
            const timerBar = document.getElementById('timer-bar');
            timerText.innerText = `${timer}s`;

            const maxTime = 30 + (activeHero.bonusTimer || 0);
            const pct = Math.max(0, (timer / maxTime) * 100);
            timerBar.style.width = `${pct}%`;

            if (timer <= 5) {
                timerText.className = "text-sm sm:text-lg font-black text-rose-500 tabular-nums drop-shadow animate-ping";
            } else {
                timerText.className = "text-sm sm:text-lg font-black text-amber-300 tabular-nums drop-shadow";
            }
        }

        /* 50:50 Lifeline */
        function useFiftyFifty() {
            if (isAnsweringBlocked) return;
            const curQ = currentQuestionIdx < QUESTION_ROSTER.length ? QUESTION_ROSTER[currentQuestionIdx] : null;
            if (!curQ) return;

            let wrongIndices = [0, 1, 2, 3].filter(i => i !== curQ.correct);
            wrongIndices.sort(() => Math.random() - 0.5);
            document.getElementById(`choice-btn-${wrongIndices[0]}`).style.opacity = '0.2';
            document.getElementById(`choice-btn-${wrongIndices[0]}`).disabled = true;
            document.getElementById(`choice-btn-${wrongIndices[1]}`).style.opacity = '0.2';
            document.getElementById(`choice-btn-${wrongIndices[1]}`).disabled = true;

            const btn = document.getElementById('hint-btn');
            btn.disabled = true;
            btn.className = "p-1.5 sm:px-2.5 bg-slate-800 border border-slate-700 rounded-xl text-xs font-black text-slate-500 cursor-not-allowed";
        }

        /* Handle User Answer Selection */
        function handleAnswer(selectedIdx) {
            if (isAnsweringBlocked) return;
            isAnsweringBlocked = true;
            clearInterval(timerInterval);

            // Cancel Freeze effect if active
            if (isTimerFrozen) {
                isTimerFrozen = false;
                document.getElementById('timer-text').classList.remove('frozen-timer');
            }

            let curQ = currentQuestionIdx < QUESTION_ROSTER.length ? QUESTION_ROSTER[currentQuestionIdx] : null;
            const isCorrect = (curQ && selectedIdx === curQ.correct);
            const timeTaken = (Date.now() - questionStartTime) / 1000;
            const isFastCrit = isCorrect && (timeTaken <= 5.5);

            // Visual feedback on choices
            for (let i = 0; i < 4; i++) {
                const btn = document.getElementById(`choice-btn-${i}`);
                if (!btn) continue;
                if (curQ && i === curQ.correct) {
                    btn.className = "w-full p-2.5 sm:p-3 bg-gradient-to-r from-emerald-600 to-emerald-700 border-2 border-emerald-300 rounded-xl sm:rounded-2xl flex items-center justify-between text-left text-xs sm:text-sm font-bold text-white shadow-lg animate-pulse";
                } else if (i === selectedIdx) {
                    btn.className = "w-full p-2.5 sm:p-3 bg-gradient-to-r from-rose-600 to-rose-700 border-2 border-rose-300 rounded-xl sm:rounded-2xl flex items-center justify-between text-left text-xs sm:text-sm font-bold text-white shadow-lg";
                }
            }

            if (isCorrect) {
                combo++;
                const comboMult = combo >= 3 ? 1.5 : 1;
                const earnedScore = Math.round((100 + timer * 10) * comboMult * (isFastCrit ? 1.5 : 1));
                score += earnedScore;
                document.getElementById('score-display').innerText = score;

                if (combo >= 2) {
                    const comboPill = document.getElementById('combo-pill');
                    comboPill.classList.remove('hidden');
                    document.getElementById('combo-count').innerText = combo;
                }

                // Reward 1 power-up when combo reaches multiples of 3
                if (combo > 0 && combo % 3 === 0) {
                    const skills = ['freeze', 'shield', 'doubleDamage'];
                    const rewarded = skills[Math.floor(Math.random() * skills.length)];
                    skillInventory[rewarded]++;
                    updateSkillBadges();
                }

                // Bow Release & Arrow Flight to Enemy (With Critical & Double DMG)
                triggerHeroShootArrow(isFastCrit);
            } else {
                combo = 0;
                document.getElementById('combo-pill').classList.add('hidden');
                triggerBossTaunt();
                triggerEnemyAttack();
            }
        }

        /* -------------------------------------------------------------
           6. PARABOLIC ARROW FLIGHT & COMBAT ANIMATIONS
        ------------------------------------------------------------- */
        function triggerHeroShootArrow(isCrit = false) {
            playSoundFx('bow_shoot');
            const heroSprite = document.getElementById('hero-sprite');

            heroSprite.classList.add('anim-hero-shoot');
            setTimeout(() => heroSprite.classList.remove('anim-hero-shoot'), 450);

            // Projectile Arrow SVG from Hero to Enemy
            const layer = document.getElementById('arrow-flight-layer');
            const arrow = document.createElement('div');
            arrow.className = "absolute pointer-events-none z-50 flex items-center";
            arrow.style.left = "80px";
            arrow.style.bottom = "80px";
            arrow.style.transition = "all 0.38s cubic-bezier(0.25, 0.46, 0.45, 0.94)";
            
            const arrowColor = isCrit || isDoubleDamageActive ? '#ef4444' : activeHero.arrowColor;
            arrow.innerHTML = `
                <svg viewBox="0 0 70 20" class="w-14 h-5 drop-shadow-[0_0_12px_${arrowColor}]">
                    <line x1="0" y1="10" x2="55" y2="10" stroke="${arrowColor}" stroke-width="4.5" stroke-linecap="round"/>
                    <polygon points="52,3 68,10 52,17" fill="${arrowColor}"/>
                    <polygon points="0,5 12,10 0,15" fill="#ffffff"/>
                </svg>
            `;
            layer.appendChild(arrow);

            requestAnimationFrame(() => {
                arrow.style.transform = "translate(min(60vw, 550px), -25px) rotate(8deg)";
                arrow.style.opacity = "1";
            });

            setTimeout(() => {
                arrow.remove();
                
                // Play audio according to hit type
                if (isCrit || isDoubleDamageActive) playSoundFx('crit_hit');
                else playSoundFx('hit');

                const enemySprite = document.getElementById('enemy-sprite');
                enemySprite.classList.add('anim-hurt');
                setTimeout(() => enemySprite.classList.remove('anim-hurt'), 500);

                // Calculate damage
                let damageDealt = activeHero.dmg;
                if (isCrit) damageDealt = Math.round(damageDealt * 1.5);
                if (isDoubleDamageActive) {
                    damageDealt *= 2;
                    isDoubleDamageActive = false; // Reset skill
                    heroSprite.classList.remove('filter', 'drop-shadow-[0_0_20px_#ef4444]');
                }

                enemyHp = Math.max(0, enemyHp - damageDealt);
                updateEnemyHpBar();

                // Show Critical Banner if triggered
                if (isCrit) {
                    const critBanner = document.getElementById('crit-banner');
                    critBanner.classList.remove('opacity-0', 'anim-crit');
                    void critBanner.offsetWidth;
                    critBanner.classList.add('anim-crit');
                    setTimeout(() => critBanner.classList.add('opacity-0'), 900);
                }

                // Show Floating Damage Text
                const enemyDmg = document.getElementById('enemy-dmg');
                enemyDmg.innerText = `-${damageDealt} ${isCrit ? '🔥 CRIT!' : '💥'}`;
                enemyDmg.style.opacity = '1';
                enemyDmg.style.transform = 'translateY(-20px)';
                enemyDmg.style.transition = 'all 0.5s ease-out';
                setTimeout(() => {
                    enemyDmg.style.opacity = '0';
                    enemyDmg.style.transform = 'translateY(0px)';
                }, 600);

                checkBattleOutcome();
            }, 380);
        }

        /* Enemy Retaliation Attack (With Shield Protection Check) */
        function triggerEnemyAttack() {
            playSoundFx('bow_shoot');
            const enemy = ENEMY_ROSTER[currentEnemyIdx];
            const enemySprite = document.getElementById('enemy-sprite');
            enemySprite.classList.add('scale-110');
            setTimeout(() => enemySprite.classList.remove('scale-110'), 300);

            // Projectile from Enemy to Hero
            const layer = document.getElementById('arrow-flight-layer');
            const arrow = document.createElement('div');
            arrow.className = "absolute pointer-events-none z-50 flex items-center";
            arrow.style.right = "80px";
            arrow.style.bottom = "80px";
            arrow.style.transition = "all 0.38s cubic-bezier(0.25, 0.46, 0.45, 0.94)";
            arrow.innerHTML = `
                <svg viewBox="0 0 70 20" class="w-14 h-5 drop-shadow-[0_0_8px_#ef4444] rotate-180">
                    <line x1="0" y1="10" x2="55" y2="10" stroke="#ef4444" stroke-width="4" stroke-linecap="round"/>
                    <polygon points="52,4 68,10 52,16" fill="#b91c1c"/>
                    <circle cx="58" cy="10" r="3" fill="#fca5a5"/>
                </svg>
            `;
            layer.appendChild(arrow);

            requestAnimationFrame(() => {
                arrow.style.transform = "translate(max(-60vw, -550px), -25px) rotate(-8deg)";
                arrow.style.opacity = "1";
            });

            setTimeout(() => {
                arrow.remove();

                // Check Divine Shield Protection
                if (isShieldActive) {
                    isShieldActive = false;
                    document.getElementById('hero-shield-vfx').classList.add('hidden');
                    playSoundFx('shield_block');

                    // Show Blocked Popup
                    const heroDmg = document.getElementById('hero-dmg');
                    heroDmg.innerText = `🛡️ ការពារបាន!`;
                    heroDmg.className = "absolute -top-12 font-black text-xl text-amber-300 opacity-100 drop-shadow-md z-30";
                    setTimeout(() => {
                        heroDmg.style.opacity = '0';
                        heroDmg.className = "absolute -top-12 font-black text-2xl text-rose-500 opacity-0 pointer-events-none drop-shadow-md z-30";
                    }, 800);
                    checkBattleOutcome();
                    return;
                }

                // If no shield: Hurt & Reduce HP
                playSoundFx('hurt');
                const heroSprite = document.getElementById('hero-sprite');
                heroSprite.classList.add('anim-hurt');
                setTimeout(() => heroSprite.classList.remove('anim-hurt'), 500);

                heroHp = Math.max(0, heroHp - enemy.dmgHearts);
                renderHearts();

                // Show Hero Hurt Damage Text
                const heroDmg = document.getElementById('hero-dmg');
                heroDmg.innerText = `-${enemy.dmgHearts} ❤️`;
                heroDmg.style.opacity = '1';
                heroDmg.style.transform = 'translateY(-20px)';
                heroDmg.style.transition = 'all 0.5s ease-out';
                setTimeout(() => {
                    heroDmg.style.opacity = '0';
                    heroDmg.style.transform = 'translateY(0px)';
                }, 600);

                checkBattleOutcome();
            }, 380);
        }

        /* Render Hearts based on Hero's HP with Danger & Crack Warning */
        function renderHearts() {
            const container = document.getElementById('hero-hp-hearts');
            container.innerHTML = '';
            for (let i = 0; i < activeHero.maxHp; i++) {
                const heartSpan = document.createElement('span');
                heartSpan.className = "transition-all duration-300";
                if (i < heroHp) {
                    heartSpan.innerText = '❤️';
                    heartSpan.className += " scale-100 opacity-100";
                } else {
                    heartSpan.innerText = '🖤';
                    heartSpan.className += " scale-90 opacity-40";
                }
                container.appendChild(heartSpan);
            }

            const gameContainer = document.getElementById('game-container');
            const arenaFloor = document.getElementById('arena-floor');
            const cracksOverlay = document.getElementById('floor-cracks-overlay');
            const abyssWarning = document.getElementById('abyss-warning-text');

            if (heroHp <= 1) {
                gameContainer.classList.add('danger-mode');
                arenaFloor.classList.add('platform-cracking');
                if (cracksOverlay) cracksOverlay.classList.remove('hidden');
                if (abyssWarning) abyssWarning.classList.remove('hidden');
            } else if (heroHp <= 2) {
                gameContainer.classList.remove('danger-mode');
                arenaFloor.classList.add('platform-cracking');
                if (cracksOverlay) cracksOverlay.classList.remove('hidden');
                if (abyssWarning) abyssWarning.classList.add('hidden');
            } else {
                gameContainer.classList.remove('danger-mode');
                arenaFloor.classList.remove('platform-cracking');
                if (cracksOverlay) cracksOverlay.classList.add('hidden');
                if (abyssWarning) abyssWarning.classList.add('hidden');
            }
        }

        /* Outcome Check (Victory / Next Stage / Dramatic Abyss Fall) */
        function checkBattleOutcome() {
            if (heroHp <= 0) {
                // Dramatic Fall into Abyss Animation
                playSoundFx('defeat');
                const heroSprite = document.getElementById('hero-sprite');
                const heroShadow = document.getElementById('hero-shadow');
                const gameContainer = document.getElementById('game-container');

                if (heroShadow) heroShadow.style.opacity = '0';
                heroSprite.classList.remove('anim-hero-idle');
                heroSprite.classList.add('fall-abyss-anim');
                gameContainer.classList.add('screen-shake');

                setTimeout(() => {
                    gameContainer.classList.remove('screen-shake');
                    showModal('😱 ធ្លាក់ជ្រោះជ្រៅបាត់ហើយ!', `អ្នកបានរអិលធ្លាក់ជ្រោះជ្រៅដោយសារឆ្លើយខុស និងបាត់បង់កម្លាំងទាំងអស់! ពិន្ទុដែលទទួលបាន: ${score}។ ចុចខាងក្រោមដើម្បីឡើងមកតស៊ូម្តងទៀត!`, '🕳️');
                }, 1400);
                return;
            }

            if (enemyHp <= 0) {
                playSoundFx('victory');
                currentEnemyIdx++;

                confetti({
                    particleCount: 140,
                    spread: 90,
                    origin: { y: 0.55 }
                });

                if (currentEnemyIdx >= ENEMY_ROSTER.length) {
                    showModal('👑 ជ័យជំនះកំពូលអ្នកបាញ់ព្រួញ!', `សូមអបអរសាទរ! អ្នកបានឈ្នះមេបិសាចគ្រប់ដំណាក់កាល និងការពារសង្វៀនជ្រោះជ្រៅដោយជោគជ័យ! ពិន្ទុសរុប: ${score}`, '🏆');
                    return;
                } else {
                    currentQuestionIdx++;
                    setTimeout(loadStage, 600);
                    return;
                }
            }

            currentQuestionIdx++;
            setTimeout(loadQuestion, 500);
        }

        function showModal(title, desc, icon) {
            document.getElementById('modal-title').innerText = title;
            document.getElementById('modal-desc').innerText = desc;
            document.getElementById('modal-icon').innerText = icon;
            document.getElementById('game-modal').classList.remove('hidden');
        }

        function restartGame() {
            document.getElementById('game-modal').classList.add('hidden');
            const heroSprite = document.getElementById('hero-sprite');
            const heroShadow = document.getElementById('hero-shadow');
            if (heroSprite) {
                heroSprite.classList.remove('fall-abyss-anim');
                heroSprite.classList.add('anim-hero-idle');
                heroSprite.style.transform = '';
                heroSprite.style.opacity = '1';
                heroSprite.style.filter = '';
            }
            if (heroShadow) heroShadow.style.opacity = '1';

            currentQuestionIdx = 0;
            currentEnemyIdx = 0;
            heroHp = activeHero.maxHp;
            score = 0;
            combo = 0;
            skillInventory = { freeze: 1, shield: 1, doubleDamage: 1 };
            isShieldActive = false;
            isDoubleDamageActive = false;
            isTimerFrozen = false;
            document.getElementById('hero-shield-vfx').classList.add('hidden');
            updateSkillBadges();

            document.getElementById('score-display').innerText = `0`;
            document.getElementById('combo-pill').classList.add('hidden');
            renderHearts();
            loadStage();
        }

        function togglePauseModal(show) {
            isGamePaused = show;
            const pauseModal = document.getElementById('pause-modal');
            if (show) pauseModal.classList.remove('hidden');
            else pauseModal.classList.add('hidden');
        }

        /* -------------------------------------------------------------
           7. CHARACTER SELECTION LOGIC
        ------------------------------------------------------------- */
        function openSelectScreen() {
            const container = document.getElementById('hero-list-container');
            container.innerHTML = '';

            HERO_ROSTER.forEach(hero => {
                const card = document.createElement('div');
                const isSelected = hero.id === activeHero.id;
                card.className = `p-3 rounded-2xl border-2 transition-all cursor-pointer flex items-center gap-3 ${isSelected ? 'border-amber-400 bg-amber-950/40 shadow-lg scale-[1.02]' : 'border-slate-700 bg-slate-800/80 hover:border-slate-500'}`;
                card.onclick = () => selectHero(hero.id);
                card.innerHTML = `
                    <div class="w-16 h-16 flex items-center justify-center shrink-0">
                        ${hero.svg}
                    </div>
                    <div class="flex-1">
                        <div class="flex items-center justify-between">
                            <h4 class="font-black text-sm sm:text-base text-amber-200">${hero.name}</h4>
                            <span class="text-xs bg-slate-900 px-2 py-0.5 rounded-full text-slate-300 font-bold">${hero.maxHp} ❤️</span>
                        </div>
                        <p class="text-[11px] text-slate-300 font-medium leading-snug mt-0.5">${hero.trait}</p>
                        <div class="text-[10px] text-amber-400 font-bold mt-1">⚔️ កម្លាំងវាយ: ${hero.dmg} DMG</div>
                    </div>
                `;
                container.appendChild(card);
            });

            document.getElementById('character-modal').classList.remove('hidden');
        }

        function closeSelectScreen() {
            document.getElementById('character-modal').classList.add('hidden');
        }

        function selectHero(heroId) {
            const found = HERO_ROSTER.find(h => h.id === heroId);
            if (found) {
                activeHero = found;
                document.getElementById('hero-sprite').innerHTML = activeHero.svg;
                document.getElementById('header-hero-name').innerText = activeHero.name.split(' ')[0];
                document.getElementById('header-hero-icon').innerText = activeHero.icon;

                const aura = document.getElementById('hero-aura');
                if (aura && activeHero.auraColor) {
                    aura.style.background = activeHero.auraColor;
                    aura.style.opacity = '0.65';
                }

                heroHp = activeHero.maxHp;
                renderHearts();
                closeSelectScreen();
            }
        }

        /* Window Load Bootstrapper */
        window.onload = function() {
            document.getElementById('hero-sprite').innerHTML = activeHero.svg;
            document.getElementById('header-hero-name').innerText = activeHero.name.split(' ')[0];
            document.getElementById('header-hero-icon').innerText = activeHero.icon;

            const aura = document.getElementById('hero-aura');
            if (aura && activeHero.auraColor) {
                aura.style.background = activeHero.auraColor;
                aura.style.opacity = '0.65';
            }

            heroHp = activeHero.maxHp;
            updateSkillBadges();
            renderHearts();
            loadStage();
        };
    </script>
</body>
</html>