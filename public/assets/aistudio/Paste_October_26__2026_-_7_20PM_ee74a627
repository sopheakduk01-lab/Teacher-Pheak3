        /* Tone.js Web Audio Synthesizer Initialization */
        let synth = null;
        function getSynth() {
            if (!synth) {
                try {
                    synth = new Tone.PolySynth(Tone.Synth).toDestination();
                } catch(e) {
                    console.log('Audio init warning:', e);
                }
            }
            return synth;
        }

        function playSoundFx(type) {
            if (audioMuted) return;
            try {
                const s = getSynth();
                if (!s) return;
                const now = Tone.now();
                if (type === 'bow_shoot') {
                    s.triggerAttackRelease(["E5", "G5"], "16n", now);
                } else if (type === 'hit') {
                    s.triggerAttackRelease(["C3", "G2"], "8n", now);
                } else if (type === 'crit_hit') {
                    s.triggerAttackRelease(["C5", "E5", "G5", "C6"], "16n", now);
                } else if (type === 'shield_block') {
                    s.triggerAttackRelease(["G4", "C5"], "8n", now);
                } else if (type === 'freeze') {
                    s.triggerAttackRelease(["B5", "F#6"], "8n", now);
                } else if (type === 'powerup') {
                    s.triggerAttackRelease(["E5", "A5", "C6"], "16n", now);
                } else if (type === 'hurt') {
                    s.triggerAttackRelease(["F2", "Eb2"], "8n", now);
                } else if (type === 'victory') {
                    s.triggerAttackRelease(["C4", "E4", "G4", "C5"], "8n", now);
                } else if (type === 'defeat') {
                    s.triggerAttackRelease(["C3", "Bb2", "Ab2", "F2"], "4n", now);
                } else if (type === 'tick') {
                    s.triggerAttackRelease("A5", "32n", now);
                }
            } catch(e) {}
        }

