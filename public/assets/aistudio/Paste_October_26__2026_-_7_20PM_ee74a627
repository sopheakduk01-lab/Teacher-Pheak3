<!DOCTYPE html>
<html lang="km">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Math Battle Quest: Abyssal Solo Duel</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Tone.js CDN for Web Audio Synthesizer -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/tone/14.8.49/Tone.min.js"></script>
    <!-- Canvas Confetti for Victory Celebration -->
    <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.9.2/dist/confetti.browser.min.js"></script>
    <!-- Google Fonts for Khmer & Display -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;600;700&family=Kantumruy+Pro:wght@400;600;700&display=swap" rel="stylesheet">

    <style>
        * {
            user-select: none;
            -webkit-user-select: none;
            font-family: 'Fredoka', 'Kantumruy Pro', sans-serif;
            -webkit-tap-highlight-color: transparent;
        }

        /* 3D Realistic Stage Perspective */
        .arena-viewport {
            perspective: 900px;
            perspective-origin: 50% 65%;
        }

        .arena-platform {
            transform: rotateX(56deg);
            transform-style: preserve-3d;
            box-shadow: 0 45px 70px -15px rgba(15, 23, 42, 0.65), 
                        inset 0 0 80px rgba(245, 158, 11, 0.25);
            transition: all 0.4s ease;
        }

        /* Abyssal Tremble & Crack animations */
        @keyframes platform-unstable {
            0%, 100% { transform: rotateX(56deg) translateY(0px) rotateZ(0deg); }
            25% { transform: rotateX(58deg) translateY(3px) rotateZ(0.8deg); }
            75% { transform: rotateX(54deg) translateY(-2px) rotateZ(-0.8deg); }
        }

        .platform-cracking {
            animation: platform-unstable 0.3s infinite ease-in-out !important;
            border-color: #ef4444 !important;
            box-shadow: 0 20px 80px rgba(239, 68, 68, 0.8), inset 0 0 80px rgba(239, 68, 68, 0.6) !important;
        }

        /* Falling into abyss game over animation */
        @keyframes plunge-to-abyss {
            0% { transform: translateY(0) scale(1) rotate(0deg); opacity: 1; }
            30% { transform: translateY(30px) scale(0.95) rotate(-8deg); opacity: 0.9; }
            100% { transform: translateY(700px) scale(0.1) rotate(45deg); opacity: 0; filter: blur(12px); }
        }

        .fall-abyss-anim {
            animation: plunge-to-abyss 1.4s cubic-bezier(0.55, 0.085, 0.68, 0.53) forwards !important;
        }

        /* Floating Void Mist */
        @keyframes mist-drift {
            0% { transform: translateX(-10%); }
            100% { transform: translateX(10%); }
        }
        .void-mist {
            animation: mist-drift 8s ease-in-out infinite alternate;
        }

        /* Idle Animations */
        @keyframes hero-float {
            0%, 100% { transform: translateY(0px) rotate(0deg); }
            50% { transform: translateY(-10px) rotate(1.5deg); }
        }
        .anim-hero-idle {
            animation: hero-float 3.4s ease-in-out infinite;
        }

        @keyframes slime-jiggle {
            0%, 100% { transform: scale(1, 1) translateY(0); }
            50% { transform: scale(1.08, 0.92) translateY(5px); }
        }
        .anim-slime-idle {
            animation: slime-jiggle 2.2s ease-in-out infinite;
        }

        /* Attack and Damage Animations */
        @keyframes hero-shoot {
            0% { transform: scale(1) translateX(0); }
            35% { transform: scale(0.92) translateX(-18px); }
            65% { transform: scale(1.12) translateX(25px); }
            100% { transform: scale(1) translateX(0); }
        }
        .anim-hero-shoot {
            animation: hero-shoot 0.45s ease-out forwards;
        }

        @keyframes take-dmg {
            0%, 100% { transform: translateX(0); filter: drop-shadow(0 0 0 transparent); }
            20% { transform: translateX(-15px) rotate(-6deg); filter: drop-shadow(0 0 16px #ef4444) brightness(1.7); }
            40% { transform: translateX(15px) rotate(6deg); filter: drop-shadow(0 0 20px #ef4444) brightness(2); }
            60% { transform: translateX(-10px); }
            80% { transform: translateX(10px); }
        }
        .anim-hurt {
            animation: take-dmg 0.5s ease-in-out;
        }

        /* Screen Shake */
        .screen-shake {
            animation: screen-quake 0.4s cubic-bezier(0.36, 0.07, 0.19, 0.97) both;
        }
        @keyframes screen-quake {
            10%, 90% { transform: translate3d(-3px, 2px, 0); }
            20%, 80% { transform: translate3d(4px, -3px, 0); }
            30%, 50%, 70% { transform: translate3d(-5px, 4px, 0); }
            40%, 60% { transform: translate3d(5px, -4px, 0); }
        }

        /* Heartbeat Danger Vignette */
        @keyframes heartbeat-pulse {
            0%, 100% { box-shadow: inset 0 0 40px rgba(220, 38, 38, 0.35); }
            50% { box-shadow: inset 0 0 95px rgba(220, 38, 38, 0.85); }
        }
        .danger-mode {
            animation: heartbeat-pulse 1s ease-in-out infinite !important;
        }

        .glass-panel {
            background: rgba(15, 23, 42, 0.78);
            backdrop-filter: blur(14px);
            border: 1px solid rgba(255, 255, 255, 0.15);
        }

        /* Power-Up Skill Badges Glow */
        .skill-glow-freeze {
            box-shadow: 0 0 15px rgba(56, 189, 248, 0.6);
        }
        .skill-glow-shield {
            box-shadow: 0 0 15px rgba(251, 191, 36, 0.6);
        }
        .skill-glow-crit {
            box-shadow: 0 0 15px rgba(239, 68, 68, 0.6);
        }

        /* Frozen timer effect */
        .frozen-timer {
            animation: pulse-ice 1s infinite alternate;
            background: linear-gradient(135deg, #0284c7, #38bdf8) !important;
            color: #ffffff !important;
            border-color: #7dd3fc !important;
        }
        @keyframes pulse-ice {
            0% { filter: drop-shadow(0 0 4px #38bdf8); }
            100% { filter: drop-shadow(0 0 12px #bae6fd); }
        }

        /* Critical Hit Text Popup */
        @keyframes crit-pop {
            0% { transform: scale(0.4) translateY(0); opacity: 0; }
            50% { transform: scale(1.3) translateY(-30px); opacity: 1; }
            100% { transform: scale(1) translateY(-50px); opacity: 0; }
        }
        .anim-crit {
            animation: crit-pop 0.9s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards;
        }

        /* Boss Taunt Bubble */
        @keyframes bubble-pop {
            0% { transform: scale(0); opacity: 0; }
            20% { transform: scale(1.1); opacity: 1; }
            30% { transform: scale(1); opacity: 1; }
            85% { transform: scale(1); opacity: 1; }
            100% { transform: scale(0.6); opacity: 0; }
        }
        .anim-taunt {
            animation: bubble-pop 2.5s ease-out forwards;
        }

        /* Custom Scrollbar for Character Selector */
        .no-scrollbar::-webkit-scrollbar {
            display: none;
        }
        .no-scrollbar {
            -ms-overflow-style: none;
            scrollbar-width: none;
        }
    </style>
</head>
<body class="bg-slate-950 text-white min-h-screen flex flex-col items-center justify-between overflow-x-hidden selection:bg-amber-500 selection:text-black">

    <!-- GAME OVERLAY & ATMOSPHERE CONTAINER -->
    <div id="game-container" class="relative w-full max-w-5xl h-screen flex flex-col justify-between overflow-hidden shadow-2xl transition-all duration-300">

        <!-- HEADER NAVIGATION & STATUS -->
        <header class="relative z-30 flex items-center justify-between px-3 sm:px-6 py-2 sm:py-3 glass-panel text-white">
            <!-- Left: Hero Avatar & Hearts -->
            <div class="flex items-center gap-2 sm:gap-2.5">
                <!-- Character Pill & Switcher -->
                <button onclick="openSelectScreen()" class="flex items-center gap-1.5 bg-gradient-to-r from-amber-400 to-amber-500 hover:from-amber-300 hover:to-amber-400 border-2 border-amber-200 px-2.5 sm:px-3 py-1 rounded-full shadow transition transform active:scale-95 text-slate-950 font-bold text-xs sm:text-sm">
                    <span id="header-hero-icon" class="text-base sm:text-lg">⭐</span>
                    <span id="header-hero-name" class="hidden md:inline font-black tracking-wide">Stella</span>
                    <span class="text-[10px] bg-slate-950/25 text-white px-1.5 py-0.5 rounded-full uppercase tracking-wider font-extrabold">ប្តូរ</span>
                </button>

                <!-- Dynamic Hearts Container -->
                <div class="flex items-center gap-1 bg-rose-950/70 border border-rose-500/50 px-2.5 py-1 rounded-full shadow-inner">
                    <span id="heart-status-icon" class="text-sm sm:text-base animate-pulse">❤️</span>
                    <div id="hero-hp-hearts" class="flex gap-0.5 text-xs sm:text-sm font-bold text-rose-400">
                        <!-- Hearts rendered dynamically -->
                    </div>
                </div>

                <!-- Combo & Score Pill -->
                <div class="hidden sm:flex items-center gap-1.5">
                    <div class="flex items-center bg-amber-950/70 border border-amber-400/50 px-2.5 py-1 rounded-full text-xs font-bold text-amber-300 shadow">
                        🏆 <span id="score-display" class="ml-1 font-black text-amber-200">0</span>
                    </div>
                    <!-- Combo Badge with Fire Overdrive -->
                    <div id="combo-pill" class="hidden flex items-center bg-gradient-to-r from-purple-900 to-rose-900 border border-pink-400 px-2.5 py-1 rounded-full text-xs font-extrabold text-pink-200 animate-bounce shadow">
                        🔥 x<span id="combo-count">0</span>
                    </div>
                </div>
            </div>

            <!-- Center: Question Stage & Animated Circular Timer -->
            <div class="flex flex-col items-center">
                <div class="flex items-center gap-2">
                    <span id="question-number" class="text-[10px] sm:text-xs font-black uppercase tracking-wider text-sky-200 bg-sky-950/90 px-2.5 py-0.5 rounded-full border border-sky-400/40 shadow-sm">
                        សំណួរទី 1
                    </span>
                    <span id="timer-text" class="text-sm sm:text-lg font-black text-amber-300 tabular-nums drop-shadow transition-all">30s</span>
                </div>
                <!-- Countdown Progress Bar -->
                <div class="w-24 sm:w-44 h-2 bg-slate-800/90 rounded-full mt-1 overflow-hidden border border-white/20 p-0.5">
                    <div id="timer-bar" class="h-full bg-gradient-to-r from-emerald-400 via-amber-400 to-rose-500 rounded-full transition-all duration-1000 w-full"></div>
                </div>
            </div>

            <!-- Right: Enemy Info, Lifeline, Mute, Pause -->
            <div class="flex items-center gap-1.5 sm:gap-2">
                <div class="text-right hidden sm:block">
                    <div id="enemy-name" class="text-xs font-black text-sky-200 tracking-wide">Jeli Slime</div>
                    <div class="text-[10px] font-semibold text-sky-300/90">ដំណាក់កាល <span id="enemy-stage-num" class="text-amber-300 font-bold">1</span> / <span id="enemy-total-stages" class="text-amber-300 font-bold">6</span></div>
                </div>
                <!-- 50:50 Lifeline Button -->
                <button id="hint-btn" onclick="useFiftyFifty()" title="ជំនួយ 50:50" class="p-1.5 sm:px-2.5 bg-indigo-600/80 hover:bg-indigo-500 border border-indigo-300/40 rounded-xl transition shadow text-xs font-black text-indigo-100 flex items-center gap-1">
                    <span>💡</span> <span class="hidden sm:inline">50:50</span>
                </button>
                <button id="sound-btn" onclick="toggleAudio()" class="p-1.5 sm:p-2 bg-slate-800/80 hover:bg-slate-700 border border-white/20 rounded-xl transition shadow text-xs sm:text-sm">
                    🔊
                </button>
                <button id="pause-btn" onclick="togglePauseModal(true)" class="p-1.5 sm:p-2 bg-slate-800/80 hover:bg-slate-700 border border-white/20 rounded-xl transition shadow text-xs font-black px-2 sm:px-2.5">
                    ⏸️
                </button>
            </div>
        </header>

        <!-- DYNAMIC BATTLEFIELD BACKGROUND (SKY, ABYSS & MOUNTAINS) -->
        <div id="backdrop-theme" class="absolute inset-0 z-0 bg-gradient-to-b from-sky-400 via-indigo-900 to-slate-950 transition-colors duration-1000">
            <!-- Distant Sun / Celestial Glow -->
            <div class="absolute top-8 left-1/2 -translate-x-1/2 w-72 h-72 bg-amber-300/20 rounded-full blur-3xl pointer-events-none"></div>

            <!-- Distant Floating Mountains / Clouds -->
            <div class="absolute bottom-40 inset-x-0 h-48 opacity-40 pointer-events-none flex items-end justify-between px-6">
                <div class="w-64 h-32 bg-indigo-800/60 rounded-t-full blur-sm"></div>
                <div class="w-80 h-44 bg-purple-900/50 rounded-t-full blur-sm"></div>
                <div class="w-72 h-36 bg-blue-900/60 rounded-t-full blur-sm"></div>
            </div>
        </div>

        <!-- 3D FLOATING ARENA & COMBAT STAGE -->
        <main class="relative flex-1 flex flex-col justify-end items-center overflow-hidden pb-2 sm:pb-6">
            
            <!-- REALM LOCATION BANNER -->
            <div id="realm-badge" class="absolute top-3 left-1/2 -translate-x-1/2 z-20 px-3 py-1 bg-slate-900/80 backdrop-blur border border-amber-400/50 rounded-full text-[11px] sm:text-xs font-black tracking-wider text-amber-300 shadow-lg flex items-center gap-1.5 transition-all">
                <span>📍</span> <span id="realm-name-text">សង្វៀនថ្មវេទមន្តលើមេឃកណ្ដាលជ្រោះជ្រៅ (Abyssal Void)</span>
            </div>

            <!-- Abyssal Bottom Pit Glow (បង្ហាញជ្រោះជ្រៅខាងក្រោម) -->
            <div id="abyss-bottom-pit" class="pointer-events-none absolute bottom-0 inset-x-0 h-44 bg-gradient-to-t from-slate-950 via-purple-950/60 to-transparent z-0 flex items-end justify-center overflow-hidden">
                <div class="void-mist w-[150%] h-24 bg-gradient-to-t from-black via-rose-950/40 to-transparent blur-xl opacity-80"></div>
                <div id="abyss-warning-text" class="hidden absolute bottom-2 text-rose-500 font-black text-xs tracking-widest animate-pulse z-10 uppercase">
                    ⚠️ គ្រោះថ្នាក់៖ កម្រាលថ្មកំពុងប្រេះស្រាំ ប្រយ័ត្នធ្លាក់ជ្រោះជ្រៅ!
                </div>
            </div>

            <!-- 3D Battle Floor with glowing runes & inlays -->
            <div class="arena-viewport absolute bottom-1 w-[92%] sm:w-[84%] h-56 sm:h-64 flex items-center justify-center pointer-events-none z-10">
                <div id="arena-floor" class="arena-platform w-full h-full rounded-[50px] bg-gradient-to-b from-amber-100 via-amber-300 to-orange-400 border-8 border-amber-600/90 relative overflow-hidden flex items-center justify-center">
                    <!-- Fissure Cracks Overlay (ពេលរងរបួសកម្រាលប្រេះ) -->
                    <div id="floor-cracks-overlay" class="hidden absolute inset-0 bg-red-950/30 mix-blend-overlay pointer-events-none">
                        <svg class="w-full h-full text-red-600/70" viewBox="0 0 500 200" fill="none" stroke="currentColor" stroke-width="3">
                            <path d="M50 80 L120 110 L180 90 L240 140 L300 80 L390 120 L460 70"/>
                            <path d="M120 110 L150 160 L190 170"/>
                            <path d="M300 80 L320 30 L360 20"/>
                        </svg>
                    </div>

                    <!-- Concentric Gold Runes -->
                    <div class="w-80 h-80 rounded-full border-4 border-amber-600/40 flex items-center justify-center">
                        <div class="w-56 h-56 rounded-full border-4 border-dashed border-amber-700/50 flex items-center justify-center">
                            <div class="w-28 h-28 rounded-full bg-amber-400/50 border-2 border-amber-700 shadow-inner"></div>
                        </div>
                    </div>
                    <!-- Tile Texture Overlay -->
                    <div class="absolute inset-0 bg-[radial-gradient(#b45309_1.5px,transparent_1.5px)] [background-size:28px_28px] opacity-25"></div>
                    <!-- Shiny Light Beam across stage -->
                    <div class="absolute -inset-x-20 top-0 h-28 bg-gradient-to-b from-white/40 to-transparent transform -skew-y-12 pointer-events-none"></div>
                </div>
            </div>

            <!-- Active Combatants (Hero vs Boss - 1 vs 1 Solo) -->
            <div class="relative z-20 w-full max-w-4xl flex justify-between items-end px-4 sm:px-14 mb-2 sm:mb-6">
                
                <!-- HERO SOLO CONTAINER -->
                <div class="relative flex items-end">
                    <div id="hero-wrapper" class="relative flex flex-col items-center transition-all duration-300">
                        <!-- Damage Indicator Floating Popup -->
                        <div id="hero-dmg" class="absolute -top-12 font-black text-2xl text-rose-500 opacity-0 pointer-events-none drop-shadow-md z-30"></div>

                        <!-- Divine Shield Visual Overlay -->
                        <div id="hero-shield-vfx" class="hidden absolute inset-[-12px] rounded-full border-4 border-amber-300/80 bg-amber-400/20 animate-pulse pointer-events-none z-30 shadow-[0_0_25px_rgba(251,191,36,0.6)]"></div>

                        <!-- Hero Elemental Aura -->
                        <div id="hero-aura" class="hero-ground-aura absolute -bottom-2 w-32 h-10 rounded-full transition-all duration-500 pointer-events-none"></div>

                        <!-- HERO SPRITE -->
                        <div id="hero-sprite" class="anim-hero-idle cursor-pointer relative min-w-[140px] min-h-[140px] sm:min-w-[165px] sm:min-h-[165px] flex items-center justify-center filter drop-shadow-[0_14px_24px_rgba(0,0,0,0.45)] transition-transform hover:scale-105 active:scale-95">
                            <!-- Dynamic SVG injected by JS -->
                        </div>

                        <!-- Soft Shadow Beneath Hero -->
                        <div id="hero-shadow" class="w-28 h-5 bg-amber-950/50 rounded-full blur-md mt-[-8px]"></div>
                    </div>
                </div>

                <!-- ENEMY CONTAINER -->
                <div id="enemy-wrapper" class="relative flex flex-col items-center transition-all duration-300">
                    <!-- Boss Taunt Speech Bubble -->
                    <div id="boss-taunt-bubble" class="absolute -top-20 z-30 bg-slate-900/95 text-amber-300 border-2 border-amber-400 text-[11px] sm:text-xs font-black px-3 py-1.5 rounded-2xl shadow-xl pointer-events-none opacity-0 whitespace-nowrap">
                        <!-- Dynamic speech -->
                    </div>

                    <!-- Enemy Health Bar above head -->
                    <div class="mb-2 bg-slate-900/90 px-3 py-1 rounded-full border border-sky-400/60 flex items-center gap-2 shadow-xl backdrop-blur-sm">
                        <span id="enemy-avatar-icon" class="text-sm">👾</span>
                        <div class="w-24 sm:w-36 h-3.5 bg-slate-800 rounded-full overflow-hidden p-0.5 border border-sky-500/40">
                            <div id="enemy-hp-bar" class="h-full bg-gradient-to-r from-sky-400 via-blue-500 to-indigo-600 rounded-full w-full transition-all duration-300"></div>
                        </div>
                        <span id="enemy-hp-text" class="text-[11px] font-black text-sky-200 tabular-nums">100/100</span>
                    </div>

                    <!-- Damage Indicator Floating Popup -->
                    <div id="enemy-dmg" class="absolute -top-14 font-black text-3xl text-yellow-300 opacity-0 pointer-events-none drop-shadow-lg z-30"></div>

                    <!-- Critical Hit Notification -->
                    <div id="crit-banner" class="absolute -top-24 font-black text-3xl sm:text-4xl text-rose-500 opacity-0 pointer-events-none z-40 drop-shadow-[0_0_15px_rgba(239,68,68,0.9)]">
                        ⚡ CRITICAL!
                    </div>

                    <!-- ENEMY SPRITE -->
                    <div id="enemy-sprite" class="anim-slime-idle cursor-pointer relative min-w-[140px] min-h-[130px] sm:min-w-[165px] sm:min-h-[150px] flex items-center justify-center filter drop-shadow-[0_14px_24px_rgba(14,165,233,0.5)] transition-transform hover:scale-105 active:scale-95">
                        <!-- Dynamic SVG injected by JS -->
                    </div>

                    <!-- Soft Shadow Beneath Enemy -->
                    <div class="w-32 h-5 bg-amber-950/50 rounded-full blur-md mt-[-8px]"></div>
                </div>

                <!-- Dedicated Arrow & Particle Layer -->
                <div id="arrow-flight-layer" class="pointer-events-none absolute inset-0 overflow-visible z-40"></div>

            </div>
        </main>

        <!-- BOTTOM PANEL: MATH QUESTION & POWER-UPS & CHOICES -->
        <footer class="relative z-30 w-full flex flex-col items-center px-3 sm:px-6 pb-2 sm:pb-4">
            
            <!-- MAGIC POWER-UP SPELLS ROW (បង្កើនភាពសប្បាយ & យុទ្ធសាស្ត្រ) -->
            <div class="w-full max-w-4xl flex items-center justify-between gap-2 mb-2 px-1">
                <div class="text-[10px] sm:text-xs font-black text-amber-300 flex items-center gap-1 tracking-wider uppercase">
                    <span>✨</span> <span>ជំនាញសីល្ប៍ពិសេស (Skills):</span>
                </div>
                <div class="flex items-center gap-2">
                    <!-- Freeze Time Skill -->
                    <button id="skill-freeze" onclick="useFreezeSkill()" title="បង្កកពេល ៨ វិនាទី" class="flex items-center gap-1 px-2.5 py-1 bg-sky-950/90 hover:bg-sky-800 border border-sky-400/60 rounded-xl text-[11px] font-black text-sky-200 transition shadow active:scale-95">
                        <span>❄️</span> <span>បង្កកពេល</span> <span id="badge-freeze" class="bg-sky-500 text-slate-950 text-[9px] px-1.5 py-0.2 rounded-full font-black">1</span>
                    </button>
                    <!-- Shield Skill -->
                    <button id="skill-shield" onclick="useShieldSkill()" title="ខែលការពារការខូចខាត ១ លើក" class="flex items-center gap-1 px-2.5 py-1 bg-amber-950/90 hover:bg-amber-800 border border-amber-400/60 rounded-xl text-[11px] font-black text-amber-200 transition shadow active:scale-95">
                        <span>🛡️</span> <span>ខែលការពារ</span> <span id="badge-shield" class="bg-amber-400 text-slate-950 text-[9px] px-1.5 py-0.2 rounded-full font-black">1</span>
                    </button>
                    <!-- Double Arrow Crit Skill -->
                    <button id="skill-double" onclick="useDoubleDamageSkill()" title="ព្រួញទ្វេ វាយខ្លាំង ២ ដង" class="flex items-center gap-1 px-2.5 py-1 bg-rose-950/90 hover:bg-rose-800 border border-rose-400/60 rounded-xl text-[11px] font-black text-rose-200 transition shadow active:scale-95">
                        <span>⚡</span> <span>ព្រួញទ្វេ (2X)</span> <span id="badge-double" class="bg-rose-500 text-white text-[9px] px-1.5 py-0.2 rounded-full font-black">1</span>
                    </button>
                </div>
