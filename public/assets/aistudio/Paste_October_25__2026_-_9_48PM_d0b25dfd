            ctx.translate(x, y);

            // Small pagoda roof / house
            ctx.fillStyle = '#b91c1c';
            ctx.beginPath();
            ctx.moveTo(-15, 0); ctx.lineTo(0, -14); ctx.lineTo(15, 0); ctx.closePath();
