        function drawSun(x, y, isHot) {
            ctx.save();
            ctx.translate(x, y);

            // Corona glow
            const glowR = isHot ? 45 : 30;
            const grad = ctx.createRadialGradient(0, 0, 10, 0, 0, glowR);
            grad.addColorStop(0, isHot ? 'rgba(251, 191, 36, 0.9)' : 'rgba(253, 186, 116, 0.7)');
            grad.addColorStop(1, 'rgba(251, 191, 36, 0)');
            ctx.fillStyle = grad;
            ctx.beginPath();
            ctx.arc(0, 0, glowR, 0, Math.PI * 2);
            ctx.fill();

            // Sun Core
            ctx.fillStyle = isHot ? '#f59e0b' : '#fb923c';
            ctx.beginPath();
            ctx.arc(0, 0, 18, 0, Math.PI * 2);
            ctx.fill();

            // Sun rays
            ctx.strokeStyle = isHot ? '#d97706' : '#ea580c';
            ctx.lineWidth = 2;
            const rayCount = 8;
            for (let i = 0; i < rayCount; i++) {
                const angle = (i * Math.PI * 2) / rayCount;
                ctx.beginPath();
                ctx.moveTo(Math.cos(angle) * 22, Math.sin(angle) * 22);
                ctx.lineTo(Math.cos(angle) * 32, Math.sin(angle) * 32);
                ctx.stroke();
            }

            // Label
            ctx.fillStyle = '#b45309';
            ctx.font = 'bold 10px Kantumruy Pro';
            ctx.textAlign = 'center';
            ctx.fillText(isHot ? "កម្តៅថ្ងៃខ្លាំង" : "ពន្លឺថយចុះ", 0, 48);

            ctx.restore();
        }

        function drawScenery(x, y) {
