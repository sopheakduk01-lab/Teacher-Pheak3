        function drawSelectedClouds(w, h) {
            ctx.save();
            const time = Date.now() * 0.001;

            if (selectedCloud === 'cirrus') {
                // Whispy thin cirrus clouds (សរសៃ)
                ctx.strokeStyle = 'rgba(255, 255, 255, 0.85)';
                ctx.lineWidth = 3;
                for (let i = 0; i < 5; i++) {
                    const cx = (i * 120 + time * 10) % (w + 100) - 50;
                    const cy = 40 + i * 15;
                    ctx.beginPath();
                    ctx.moveTo(cx, cy);
                    ctx.bezierCurveTo(cx + 40, cy - 10, cx + 70, cy + 10, cx + 110, cy - 5);
                    ctx.stroke();
                }
            } else if (selectedCloud === 'wind_cloud') {
                // Scattered wind clouds (ខ្យល់)
                ctx.fillStyle = 'rgba(255, 255, 255, 0.85)';
                for (let i = 0; i < 4; i++) {
                    const cx = (i * 140 + time * 25) % (w + 120) - 60;
                    const cy = 60 + (i % 2) * 35;
                    drawSingleCloud(cx, cy, 55, 20);
                }
            } else if (selectedCloud === 'wave_cloud') {
                // Parallel wave clouds (រលក)
                ctx.fillStyle = 'rgba(255, 255, 255, 0.8)';
                for (let row = 0; row < 3; row++) {
                    for (let col = 0; col < 6; col++) {
                        const cx = (col * 80 + row * 20 + time * 8) % (w + 80) - 40;
                        const cy = 45 + row * 25;
                        drawSingleCloud(cx, cy, 35, 12);
                    }
                }
            } else {
                // Cumulus thick thunder clouds (ផ្តុំផ្កា)
                const isDark = selectedSeason === 'rainy';
                ctx.fillStyle = isDark ? '#475569' : '#f1f5f9';
                for (let i = 0; i < 3; i++) {
                    const cx = (i * 180 + time * 12) % (w + 160) - 80;
                    const cy = 70;
                    drawCumulusCloud(cx, cy, 80);
                }
            }
            ctx.restore();
        }

        function drawSingleCloud(x, y, w, h) {
            ctx.beginPath();
            ctx.ellipse(x, y, w, h, 0, 0, Math.PI * 2);
            ctx.fill();
        }

        function drawCumulusCloud(x, y, scale) {
            ctx.beginPath();
            ctx.arc(x, y, scale * 0.45, 0, Math.PI * 2);
            ctx.arc(x + scale * 0.35, y - scale * 0.2, scale * 0.5, 0, Math.PI * 2);
            ctx.arc(x + scale * 0.7, y, scale * 0.42, 0, Math.PI * 2);
            ctx.arc(x + scale * 0.35, y + scale * 0.15, scale * 0.35, 0, Math.PI * 2);
            ctx.closePath();
            ctx.fill();
        }

        function drawRain(w, groundY) {
            ctx.strokeStyle = '#0284c7';
            ctx.lineWidth = 1.5;
            rainDrops.forEach(drop => {
                ctx.beginPath();
                ctx.moveTo(drop.x, drop.y);
                ctx.lineTo(drop.x - 3, drop.y + drop.len);
                ctx.stroke();

                drop.y += drop.speed;
                drop.x -= 1;
                if (drop.y > groundY) {
                    drop.y = 80;
                    drop.x = Math.random() * w;
                }
            });
        }

