        function drawThermalCirculation(w, h, groundY) {
            const time = Date.now() * 0.002;
            const speed = sunHot ? 2 : 1;

            // Hot air rising from land (Red arrows ↑)
            drawFlowArrow(w * 0.28, groundY - 20, 0, -1, '#ef4444', "ខ្យល់ក្តៅហោះឡើង ↑", time * speed);
            drawFlowArrow(w * 0.35, groundY - 45, 0, -1, '#ef4444', "", time * speed);

            // High altitude transfer towards sea (Purple arrow →)
            drawFlowArrow(w * 0.50, 80, 1, 0, '#8b5cf6', "ចលនាវិលវល់លើមេឃ →", time * speed);

            // Cold air sinking over cool sea (Blue arrow ↓)
            drawFlowArrow(w * 0.78, 120, 0, 1, '#0284c7', "ខ្យល់ត្រជាក់ធ្លាក់ចុះ ↓", time * speed);

