            updateSim();
        }

        function updateSim() {
            let tempText = "";
            let windSpeed = 0;
            let windDesc = "";
            let humidity = 50;
            let humDesc = "";
            let formula = "";
            let explanation = "";

            if (simMode === 'wind_thermal') {
                if (sunHot) {
                    tempText = "សីតុណ្ហភាពដី៖ ៣៤°C (ក្តៅខ្លាំង)";
