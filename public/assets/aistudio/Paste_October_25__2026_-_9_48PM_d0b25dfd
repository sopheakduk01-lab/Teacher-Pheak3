                    windDesc = "ខ្យល់បក់លឿន (ចរន្តកម្ដៅខ្លាំង)";
                    humidity = 55;
                    humDesc = "ខ្យល់ស្ងួតហួតហែង";
                    formula = "ខ្យល់ក្តៅហោះឡើងលើ ↑ រីឯខ្យល់ត្រជាក់ធ្លាក់ចុះក្រោម ↓";
                    explanation = "នៅពេលពន្លឺព្រះអាទិត្យកម្ដៅដី ខ្យល់ជាប់ផ្ទៃដីឡើងក្តៅហើយស្រាល រួចហោះឡើងលើ។ ខ្យល់ត្រជាក់ពីលើនិងសមុទ្របក់ចូលជំនួស បង្កើតបានជាចរន្តវិលវល់បង្កើតជាខ្យល់បក់ (ទំព័រ ១១៣)។";
                    document.getElementById('canvas-badge-state').innerText = "ខ្យល់ក្តៅហោះឡើងលើ (វិលវល់)";
                } else {
                    tempText = "សីតុណ្ហភាពដី៖ ២៤°C (ត្រជាក់ស្រួល)";
                    windSpeed = 8;
                    windDesc = "ខ្យល់បក់រំភើយៗ";
                    humidity = 70;
                    humDesc = "សំណើមលំនឹង";
                    formula = "កម្ដៅថយចុះ -> ចលនាខ្យល់ថយចុះស្រួលខ្លួន";
                    explanation = "ពេលពន្លឺព្រះអាទិត្យថយចុះ ភាពខុសគ្នានៃកម្តៅរវាងដីនិងខ្យល់ថយចុះ ធ្វើឱ្យខ្យល់ស្ងប់ ស្លឹកឈើ និងទង់ជាតិមានចលនាតិចតួច (ទំព័រ ១១៣)។";
                    document.getElementById('canvas-badge-state').innerText = "ខ្យល់ស្ងប់ (ត្រជាក់ស្រួល)";
                }
            } else {
                const c = cloudInfo[selectedCloud];
                if (selectedSeason === 'rainy') {
                    tempText = `រដូវវស្សា (${c.name})`;
                    windSpeed = selectedCloud === 'cumulus' ? 28 : 16;
                    windDesc = selectedCloud === 'cumulus' ? "ខ្យល់កន្ត្រាក់មុនភ្លៀង" : "ខ្យល់មូសុងសើម";
                    humidity = selectedCloud === 'cumulus' ? 90 : 75;
                    humDesc = selectedCloud === 'cumulus' ? "ភ្លៀងធ្លាក់ជោគជាំ" : "ផ្ទៃមេឃស្រទុំ";
                    formula = `${c.name} -> បាំងពន្លឺថ្ងៃ បង្កើតជាម្លប់ និងទឹកភ្លៀង`;
                    explanation = `ប្រទេសកម្ពុជាក្នុងរដូវវស្សា (ខែឧសភា ដល់ តុលា) មានសំណើមខ្ពស់ និងពពកផ្តុំផ្កាបង្កឱ្យមានភ្លៀងធ្លាក់ អំណោយផលដល់វិស័យកសិកម្ម (ទំព័រ ១១៤-១១៥)។`;
                    document.getElementById('canvas-badge-state').innerText = selectedCloud === 'cumulus' ? "មានភ្លៀងធ្លាក់" : "ម្លប់ត្រជាក់";
                } else {
                    tempText = `រដូវប្រាំង (${c.name})`;
                    windSpeed = 12;
                    windDesc = "ខ្យល់ក្តៅស្ងួត";
                    humidity = 40;
                    humDesc = "កម្រិតភ្លៀងទាប";
                    formula = "រដូវប្រាំង (វិច្ឆិកា-មេសា) -> មេឃស្រឡះ ភ្លៀងតិចតួច";
                    explanation = "ក្នុងរដូវប្រាំង ពន្លឺព្រះអាទិត្យចាំងខ្លាំង ផ្ទៃមេឃច្រើនមានតែពពកសរសៃស្តើងៗ ធាតុអាកាសក្តៅ និងស្ងួតហួតហែង (ទំព័រ ១១៤)។";
                    document.getElementById('canvas-badge-state').innerText = "ហួតហែង";
                }
            }

            document.getElementById('canvas-badge-temp').innerText = tempText;
            document.getElementById('res-wind-val').innerText = `${windSpeed} km/h`;
            document.getElementById('res-wind-desc').innerText = windDesc;
            document.getElementById('res-humidity-val').innerText = `${humidity} %`;
            document.getElementById('res-humidity-desc').innerText = humDesc;
            document.getElementById('calc-step-formula').innerText = formula;
            document.getElementById('res-explanation').innerText = explanation;
        }

        // ==========================================
        // ANIMATION LOOP (CANVAS GRAPHICS)
        // ==========================================
        function resizeCanvas() {
            const rect = canvas.parentElement.getBoundingClientRect();
            canvas.width = rect.width;
            canvas.height = 330;
            initParticles();
        }

        window.addEventListener('resize', () => {
            if (!document.getElementById('panel-simulation').classList.contains('hidden')) {
                resizeCanvas();
            }
        });

        function initParticles() {
            windParticles = [];
            for (let i = 0; i < 35; i++) {
                windParticles.push({
                    x: Math.random() * canvas.width,
                    y: Math.random() * canvas.height,
                    speed: 1 + Math.random() * 2,
                    rad: 2 + Math.random() * 2,
                    isHot: Math.random() > 0.5
                });
            }

            rainDrops = [];
            for (let i = 0; i < 50; i++) {
                rainDrops.push({
                    x: Math.random() * canvas.width,
                    y: Math.random() * canvas.height,
                    len: 8 + Math.random() * 8,
                    speed: 4 + Math.random() * 4
                });
            }
        }

        function renderLoop() {
            const w = canvas.width;
            const h = canvas.height;
            ctx.clearRect(0, 0, w, h);

            if (simMode === 'wind_thermal') {
                drawWindThermalScene(w, h);
            } else {
                drawCloudsRainScene(w, h);
            }

            if (animActive) {
                requestAnimationFrame(renderLoop);
            }
        }

        // SCENE 1: Thermal Convection & Wind Loop (ទំព័រ ១១៣)
        function drawWindThermalScene(w, h) {
            // Sky background
            const skyGrad = ctx.createLinearGradient(0, 0, 0, h);
            if (sunHot) {
                skyGrad.addColorStop(0, '#bae6fd');
                skyGrad.addColorStop(0.7, '#e0f2fe');
                skyGrad.addColorStop(1, '#fef3c7');
            } else {
                skyGrad.addColorStop(0, '#93c5fd');
                skyGrad.addColorStop(0.7, '#dbeafe');
                skyGrad.addColorStop(1, '#fed7aa');
            }
            ctx.fillStyle = skyGrad;
            ctx.fillRect(0, 0, w, h);

            // Ground & Sea
            const groundY = h - 65;
            // Sea (Right side)
            ctx.fillStyle = '#0284c7';
            ctx.fillRect(w * 0.55, groundY, w * 0.45, 65);

            // Land & Hills (Left side)
            ctx.fillStyle = '#22c55e';
            ctx.beginPath();
            ctx.moveTo(0, groundY - 40);
            ctx.quadraticCurveTo(w * 0.2, groundY - 70, w * 0.35, groundY);
            ctx.lineTo(w * 0.55, groundY);
            ctx.lineTo(w * 0.55, h);
            ctx.lineTo(0, h);
            ctx.closePath();
            ctx.fill();

            // Sun
            const sunX = sunHot ? w * 0.2 : w * 0.12;
