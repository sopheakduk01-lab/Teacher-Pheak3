                    "កើតពីដំណក់ទឹកដែលមានជាតិកំបោរស្រក់មកលើដី ហើយដុះច្រូងច្រាងពីបាតល្អាងឡើងទៅលើ",
                    "ដុះលើដើមឈើនៅមាត់ល្អាងភ្នំ",
                    "អណ្តែតនៅលើពពកក្នុងបរិយាកាស"
                ],
                correct: 1,
                exp: "ទំព័រ ១១៥៖ ស្តាឡាក់មីត (Stalagmite) គឺជាថ្មកំបោរដែលកកើតពីបាតក្រោមនៃល្អាងដុះឡើងទៅលើ។"
            },
            {
                cat: 'phenomena',
                q: "៣៩. ហេតុអ្វីបានជាទឹកភ្លៀងអាចរំលាយ និងឆ្លាក់ថ្មកំបោរឱ្យក្លាយជារូងល្អាង និងទម្រង់ស្តាឡាក់ទីត/ស្តាឡាក់មីតបាន?",
                options: [
                    "ពីព្រោះទឹកភ្លៀងមានផ្ទុកកម្តៅរាប់ពាន់អង្សាសេដែលអាចរំលាយថ្មបានភ្លាមៗ",
                    "ពីព្រោះទឹកភ្លៀងស្រូបឧស្ម័នកាបូនិចពីបរិយាកាស បង្កើតជាអាស៊ីតខ្សោយដែលរំលាយជាតិកំបោរយឺតៗរាប់ពាន់ឆ្នាំ",
                    "ពីព្រោះទឹកភ្លៀងធ្លាក់មកដោយកម្លាំងល្បឿនលឿនដូចគ្រាប់កាំភ្លើងទម្លុះភ្នំ",
                    "ពីព្រោះថ្មកំបោរធ្វើពីស្ករសដែលត្រូវតែរលាយពេលប៉ះទឹក"
                ],
                correct: 1,
                exp: "ទឹកភ្លៀងមានជាតិអាស៊ីតកាបូនិកខ្សោយ កាលណាជ្រាបតាមប្រេះស្រាំនៃថ្មកំបោរ វានឹងរំលាយថ្មកំបោរយឺតៗរាប់ពាន់ឆ្នាំ បង្កើតបានជាល្អាង និងទម្រង់ស្តាឡាក់ទីត/មីត។"
            },
            {
                cat: 'phenomena',
                q: "៤០. តើការស្វែងយល់ដឹងពី «ធាតុអាកាស និងអាកាសធាតុ» ផ្ដល់ប្រយោជន៍ជាក់ស្តែងអ្វីខ្លះដល់សង្គមជាតិ?",
                options: [
                    "ជួយក្នុងការរៀបចំផែនការកសិកម្ម ការពារគ្រោះរាំងស្ងួត និងទឹកជំនន់ ព្រមទាំងថែរក្សាតំបន់ទេសចរណ៍ធម្មជាតិ",
                    "ជួយឱ្យមនុស្សមិនបាច់បរិភោគបាយ និងទឹកទៀតឡើយ",
                    "ជួយបញ្ឈប់ការរះឡើងនៃព្រះអាទិត្យជារៀងរាល់ថ្ងៃ",
                    "ជួយផ្លាស់ប្តូរទីតាំងនៃប្រទេសកម្ពុជាទៅកាន់ប៉ូលខាងជើង"
                ],
                correct: 0,
                exp: "ការយល់ដឹងពីធាតុអាកាស និងអាកាសធាតុ មានសារៈសំខាន់បំផុតសម្រាប់វិស័យកសិកម្ម ទេសចរណ៍ សំណង់ និងការទប់ស្កាត់គ្រោះមហន្តរាយធម្មជាតិ។"
            }
        ];

        let userAnswers = {};
        let currentQIndex = 0;

        function renderStepQuestion() {
            const host = document.getElementById('quiz-step-host');
            const item = qcmDatabase[currentQIndex];
            const hasAnswered = userAnswers.hasOwnProperty(currentQIndex);
            const selectedOpt = userAnswers[currentQIndex];

            // Update Labels
            document.getElementById('current-q-label').innerText = currentQIndex + 1;
            const progressPercent = ((currentQIndex + 1) / qcmDatabase.length) * 100;
            document.getElementById('quiz-progress-bar').style.width = `${progressPercent}%`;

            // Update Previous/Next button states
            document.getElementById('btn-prev-q').disabled = (currentQIndex === 0);
            document.getElementById('btn-next-q').disabled = (currentQIndex === qcmDatabase.length - 1);

            // Category badge
            const catMap = {
                'weather': '<span class="text-[11px] font-bold px-2.5 py-0.5 rounded-full bg-sky-50 text-sky-800 border border-sky-200">១. ធាតុអាកាស (ទំព័រ ១១២)</span>',
                'factors': '<span class="text-[11px] font-bold px-2.5 py-0.5 rounded-full bg-amber-50 text-amber-800 border border-amber-200">២. កត្តាប្រែប្រួល (ទំព័រ ១១២-១១៤)</span>',
                'climate': '<span class="text-[11px] font-bold px-2.5 py-0.5 rounded-full bg-emerald-50 text-emerald-800 border border-emerald-200">៣. អាកាសធាតុ (ទំព័រ ១១៤-១១៥)</span>',
                'phenomena': '<span class="text-[11px] font-bold px-2.5 py-0.5 rounded-full bg-indigo-50 text-indigo-800 border border-indigo-200">៤. បាតុភូតធម្មជាតិ (ទំព័រ ១១៥)</span>'
            };

            host.innerHTML = `
                <div class="p-5 sm:p-6 rounded-2xl border border-slate-200 bg-white space-y-4 shadow-xs transition-all">
                    <div class="flex items-center justify-between gap-2 border-b border-slate-100 pb-3">
                        <div class="flex items-center gap-2">
                            ${catMap[item.cat] || ''}
                        </div>
                        <span class="text-xs font-mono font-semibold text-slate-500">សំណួរ ${currentQIndex + 1} នៃ ៤០</span>
                    </div>

                    <div class="text-slate-900 font-semibold text-sm sm:text-base leading-relaxed">
                        ${item.q}
                    </div>

                    <div class="space-y-2.5 pt-2">
                        ${item.options.map((opt, optIdx) => {
                            let btnStyle = "border-slate-200 bg-slate-50 hover:bg-slate-100 text-slate-700";
                            let iconState = "";

                            if (hasAnswered) {
                                if (optIdx === item.correct) {
                                    btnStyle = "border-emerald-500 bg-emerald-50 text-emerald-950 font-semibold shadow-xs ring-1 ring-emerald-400";
                                    iconState = '<i class="fa-solid fa-circle-check text-emerald-600 ml-auto shrink-0 text-base"></i>';
                                } else if (selectedOpt === optIdx) {
                                    btnStyle = "border-rose-400 bg-rose-50 text-rose-950 font-semibold shadow-xs ring-1 ring-rose-300";
                                    iconState = '<i class="fa-solid fa-circle-xmark text-rose-600 ml-auto shrink-0 text-base"></i>';
                                } else {
                                    btnStyle = "border-slate-200 bg-white text-slate-400 opacity-60";
                                }
                            }

                            return `
                                <button onclick="handleSelectStepAnswer(${optIdx})" 
                                    class="w-full text-left p-3.5 rounded-xl border text-xs sm:text-sm transition duration-150 active:scale-[0.99] flex items-start gap-3 ${btnStyle}">
                                    <span class="font-mono font-bold px-2 py-0.5 rounded-md bg-white border border-slate-200 shrink-0 text-slate-800">
                                        ${['ក.', 'ខ.', 'គ.', 'ឃ.'][optIdx]}
                                    </span>
                                    <span class="flex-grow pt-0.5">${opt}</span>
                                    ${iconState}
                                </button>
                            `;
                        }).join('')}
                    </div>

                    <div class="text-xs sm:text-sm p-4 rounded-xl ${hasAnswered ? '' : 'hidden'} ${hasAnswered ? (selectedOpt === item.correct ? 'bg-emerald-50 border border-emerald-200 text-emerald-950' : 'bg-rose-50 border border-rose-200 text-rose-950') : ''}">
                        ${hasAnswered ? (selectedOpt === item.correct 
                            ? `<div class="flex items-start gap-2.5"><i class="fa-solid fa-circle-check text-emerald-600 mt-0.5 text-base"></i><div><strong>ចម្លើយត្រឹមត្រូវ!</strong> ${item.exp}</div></div>` 
                            : `<div class="flex items-start gap-2.5"><i class="fa-solid fa-circle-xmark text-rose-600 mt-0.5 text-base"></i><div><strong>ចម្លើយមិនទាន់ត្រឹមត្រូវទេ!</strong> ${item.exp}</div></div>`) : ''}
                    </div>
                </div>
            `;

            renderQuickNavigator();
            updateScoreBadge();
        }

        function handleSelectStepAnswer(optIdx) {
            userAnswers[currentQIndex] = optIdx;
            renderStepQuestion();
        }

        function nextQuestion() {
            if (currentQIndex < qcmDatabase.length - 1) {
                currentQIndex++;
                renderStepQuestion();
            }
        }

        function prevQuestion() {
            if (currentQIndex > 0) {
                currentQIndex--;
                renderStepQuestion();
            }
        }

        function jumpToQuestion(idx) {
            currentQIndex = idx;
            renderStepQuestion();
        }

        function renderQuickNavigator() {
            const nav = document.getElementById('quiz-number-navigator');
            nav.innerHTML = qcmDatabase.map((item, idx) => {
                const hasAnswered = userAnswers.hasOwnProperty(idx);
                let bg = "bg-slate-100 text-slate-700 hover:bg-slate-200";
                let ring = (idx === currentQIndex) ? "ring-2 ring-sky-500 font-bold" : "";

                if (hasAnswered) {
                    if (userAnswers[idx] === item.correct) {
                        bg = "bg-emerald-600 text-white font-semibold";
                    } else {
                        bg = "bg-rose-500 text-white font-semibold";
                    }
                }

                return `
                    <button onclick="jumpToQuestion(${idx})" class="w-full py-1.5 rounded-lg text-xs font-mono transition text-center ${bg} ${ring}">
                        ${idx + 1}
                    </button>
                `;
            }).join('');
        }

        function updateScoreBadge() {
            let correct = 0;
            qcmDatabase.forEach((item, idx) => {
                if (userAnswers[idx] === item.correct) {
                    correct++;
                }
            });
            document.getElementById('quiz-score-badge').innerText = correct;
        }

        function resetQuiz() {
            userAnswers = {};
            currentQIndex = 0;
            renderStepQuestion();
        }

        // Initialize on page load
        window.onload = function() {
            renderDynamicControls();
            resizeCanvas();
            renderStepQuestion();
            updateSim();
            renderLoop();
        };
    </script>
</body>
