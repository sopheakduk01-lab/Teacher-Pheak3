            ctx.fillStyle = skyGrad;
            ctx.fillRect(0, 0, w, h);

            // Ground with rice field / terrain
            const groundY = h - 60;
            ctx.fillStyle = selectedSeason === 'rainy' ? '#16a34a' : '#ca8a04';
