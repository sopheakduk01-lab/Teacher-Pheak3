            'cumulus': { name: 'ពពកផ្តុំផ្កា', desc: 'ពពកដុំៗក្រាស់ៗ បាំងពន្លឺថ្ងៃ និងងាយបង្កជាភ្លៀងផ្គររន្ទះ', rainRate: 0.8 }
        };

        function setSimMode(mode) {
            simMode = mode;
            ['wind_thermal', 'clouds_rain'].forEach(m => {
                const btn = document.getElementById(`btn-mode-${m}`);
