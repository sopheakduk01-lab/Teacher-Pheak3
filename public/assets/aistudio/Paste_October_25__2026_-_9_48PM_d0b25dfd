        function drawFlowArrow(x, y, dx, dy, color, label, animPhase) {
            ctx.save();
            ctx.translate(x + dx * Math.sin(animPhase) * 6, y + dy * Math.sin(animPhase) * 6);
            ctx.fillStyle = color;
            ctx.strokeStyle = color;
            ctx.lineWidth = 3;

            // Arrow line
            ctx.beginPath();
            ctx.moveTo(0, 0);
            ctx.lineTo(dx * 26, dy * 26);
            ctx.stroke();

            // Head
            ctx.beginPath();
            const angle = Math.atan2(dy, dx);
            ctx.moveTo(dx * 28, dy * 28);
            ctx.lineTo(dx * 28 - 7 * Math.cos(angle - Math.PI / 6), dy * 28 - 7 * Math.sin(angle - Math.PI / 6));
            ctx.lineTo(dx * 28 - 7 * Math.cos(angle + Math.PI / 6), dy * 28 - 7 * Math.sin(angle + Math.PI / 6));
            ctx.closePath();
            ctx.fill();

            if (label) {
                ctx.font = 'bold 10px Kantumruy Pro';
                ctx.textAlign = 'center';
                ctx.fillText(label, dx * 14, dy * 14 - 8);
            }

            ctx.restore();
        }

