            } else if (sec === 'phenomena') {
                text = "៤. បាតុភូតធម្មជាតិ និងកំណឹកដោយសារទឹកភ្លៀង (ទំព័រ ១១៥)\n- ភ្នំសំពៅ និងភ្នំកំពង់ត្រាច (កើតពីថ្មកំបោរ) រងកំណឹកដោយសារទឹកភ្លៀង\n- ស្តាឡាក់ទីត (Stalactite)៖ ដុះស្រក់ចុះពីពិដានល្អាងមកក្រោម\n- ស្តាឡាក់មីត (Stalagmite)៖ ដុះច្រូងច្រាងពីបាតល្អាងឡើងលើ។";
            }
            const temp = document.createElement('textarea');
            temp.value = text;
            document.body.appendChild(temp);
            temp.select();
            document.execCommand('copy');
            document.body.removeChild(temp);
            showToast("បានចម្លងផ្នែកនេះដោយជោគជ័យ!");
        }

        function showToast(msg) {
            const toast = document.getElementById('copy-toast');
            document.getElementById('toast-text').innerText = msg;
            toast.classList.remove('opacity-0', 'pointer-events-none');
            setTimeout(() => {
                toast.classList.add('opacity-0', 'pointer-events-none');
            }, 2300);
        }

        // ==========================================
        // SIMULATOR ENGINE (WEATHER & CLIMATE LAB)
        // ==========================================
        let simMode = 'wind_thermal'; // 'wind_thermal' or 'clouds_rain'
        let sunHot = true;
        let animActive = true;
        let windParticles = [];
        let rainDrops = [];
        const canvas = document.getElementById('weatherCanvas');
        const ctx = canvas.getContext('2d');

        // State for Mode 1: Wind & Sun
        let timeOfDay = 'day'; // 'day' or 'afternoon'

        // State for Mode 2: Clouds & Rain
        let selectedCloud = 'cumulus'; // 'cirrus', 'wind_cloud', 'wave_cloud', 'cumulus'
        let selectedSeason = 'rainy'; // 'rainy' (May-Oct) or 'dry' (Nov-Apr)

        const cloudInfo = {
            'cirrus': { name: 'ពពកសរសៃ', desc: 'ពពកស្តើង ស្រាលដូចសរសៃសូត្រនៅលើមេឃខ្ពស់ មិនបង្កភ្លៀងទេ', rainRate: 0 },
            'wind_cloud': { name: 'ពពកខ្យល់', desc: 'ពពករាយប៉ាយតាមកម្លាំងខ្យល់បក់ ធាតុអាកាសមានខ្យល់រំភើយៗ', rainRate: 0.1 },
