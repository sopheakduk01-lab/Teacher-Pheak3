    let userQcmChoices = {};
    let activeQIdx = 0;
    let quizSecs = 0;
    let quizInterval = null;

    function initQcmSystem() {
      activeQIdx = 0;
      renderQcmNavGrid();
      renderQcmCard(activeQIdx);
      startQuizTimer();
      updateMetrics();
    }

    function startQuizTimer() {
      if (quizInterval) clearInterval(quizInterval);
      quizSecs = 0;
      quizInterval = setInterval(() => {
        quizSecs++;
        const m = String(Math.floor(quizSecs / 60)).padStart(2, '0');
        const s = String(quizSecs % 60).padStart(2, '0');
        const el = document.getElementById('quizTimerText');
        if (el) el.innerText = `${m}:${s}`;
      }, 1000);
    }

    function renderQcmNavGrid() {
      const grid = document.getElementById('qcmGridNav');
      if (!grid) return;
      grid.innerHTML = qcmDataset.map((_, i) => {
        const choice = userQcmChoices[i];
        const isAnswered = choice !== undefined;
        const isCorrect = isAnswered && choice === qcmDataset[i].ans;
        const isCurrent = i === activeQIdx;

        let statusClass = "bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 border-slate-200 dark:border-slate-700";
        if (isAnswered) {
          statusClass = isCorrect ? "bg-emerald-600 border-emerald-700 text-white" : "bg-rose-500 border-rose-600 text-white";
        }
        const ringClass = isCurrent ? "ring-2 ring-brandGold-500 scale-105" : "";

        return `
          <button onclick="jumpToQcmStep(${i})" class="w-full py-1 rounded-lg text-[11px] font-bold border transition ${statusClass} ${ringClass}">
            ${i + 1}
          </button>
        `;
      }).join('');
    }

    function jumpToQcmStep(idx) {
      activeQIdx = idx;
      renderQcmCard(activeQIdx);
      renderQcmNavGrid();
      const card = document.getElementById('qcmStepCard');
      if (card) card.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }

    function renderQcmCard(idx) {
      const container = document.getElementById('qcmStepContent');
      if (!container) return;

      const item = qcmDataset[idx];
      const userChoice = userQcmChoices[idx];
      const isAnswered = userChoice !== undefined;
      const isCorrect = isAnswered && userChoice === item.ans;

      container.innerHTML = `
        <div class="flex items-start justify-between gap-3 mb-4">
          <h4 class="font-bold text-xs sm:text-base text-slate-900 dark:text-slate-100 leading-snug">
            <span class="inline-flex items-center justify-center w-7 h-7 rounded-xl bg-amber-100 dark:bg-slate-800 text-brandGold-700 dark:text-amber-400 font-mono text-xs font-bold mr-2">${idx + 1}</span>
            ${item.q.replace(/^\d+\.\s*/, '')}
          </h4>
          <span class="shrink-0 text-[10px] sm:text-xs px-3 py-1 rounded-full font-bold ${
            !isAnswered ? 'bg-slate-100 text-slate-400 dark:bg-slate-800' :
            isCorrect ? 'bg-emerald-100 text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300' : 'bg-rose-100 text-rose-800 dark:bg-rose-950 dark:text-rose-300'
          }">
            ${!isAnswered ? 'មិនទាន់ឆ្លើយ' : (isCorrect ? 'ត្រឹមត្រូវ ✓' : 'មិនត្រឹមត្រូវ ✗')}
          </span>
        </div>

        <div class="space-y-2.5">
          ${item.options.map((opt, optIdx) => {
            let itemStyle = 'border-slate-200/80 dark:border-slate-800 bg-slate-50 dark:bg-slate-800/40 hover:bg-slate-100 dark:hover:bg-slate-800';
            if (isAnswered) {
              if (optIdx === item.ans) {
                itemStyle = 'border-emerald-500 bg-emerald-50 dark:bg-emerald-950/60 text-emerald-900 dark:text-emerald-200 font-semibold ring-1 ring-emerald-500';
              } else if (optIdx === userChoice) {
                itemStyle = 'border-rose-500 bg-rose-50 dark:bg-rose-950/60 text-rose-900 dark:text-rose-200 font-semibold ring-1 ring-rose-500';
              }
            }

            return `
              <button type="button" onclick="selectQcmAnswer(${idx}, ${optIdx})" class="w-full text-left flex items-center gap-3 p-3 sm:p-3.5 rounded-2xl border text-xs sm:text-sm cursor-pointer transition ${itemStyle}">
                <span class="w-6 h-6 rounded-xl flex items-center justify-center text-xs font-bold ${
                  isAnswered && optIdx === item.ans ? 'bg-emerald-600 text-white' :
                  (isAnswered && optIdx === userChoice ? 'bg-rose-600 text-white' : 'bg-white dark:bg-slate-700 text-slate-600 dark:text-slate-300 border border-slate-200 dark:border-slate-600')
                }">
                  ${String.fromCharCode(65 + optIdx)}
                </span>
                <span class="leading-relaxed flex-1">${opt}</span>
                ${isAnswered && optIdx === item.ans ? '<i class="fa-solid fa-circle-check text-emerald-600 text-base"></i>' : ''}
                ${isAnswered && optIdx === userChoice && !isCorrect ? '<i class="fa-solid fa-circle-xmark text-rose-600 text-base"></i>' : ''}
              </button>
            `;
          }).join('')}
        </div>

        <div class="${isAnswered ? 'block' : 'hidden'} mt-4 p-4 rounded-2xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200/80 dark:border-slate-700 text-xs text-slate-700 dark:text-slate-300">
          <div class="font-bold text-amber-700 dark:text-amber-400 mb-1 flex items-center gap-1.5">
            <i class="fa-solid fa-circle-info"></i> ការពន្យល់លម្អិត ៖
          </div>
          <p class="leading-relaxed">${item.exp}</p>
        </div>
      `;

      // Update Step Controls
      const prevBtn = document.getElementById('qcmPrevBtn');
      const nextBtn = document.getElementById('qcmNextBtn');
      const indicator = document.getElementById('qcmStepIndicator');
      const badge = document.getElementById('qcmCurrentNumBadge');

      if (prevBtn) prevBtn.disabled = idx === 0;
      if (indicator) indicator.innerText = `${idx + 1} / 40`;
      if (badge) badge.innerText = idx + 1;

      if (nextBtn) {
        if (idx === qcmDataset.length - 1) {
          nextBtn.innerHTML = `<span>បញ្ចប់ & វិញ្ញាបនបត្រ</span> <i class="fa-solid fa-flag-checkered"></i>`;
          nextBtn.className = "px-5 py-2.5 rounded-2xl bg-emerald-600 hover:bg-emerald-700 text-xs font-bold text-white flex items-center gap-2 shadow-md shadow-emerald-500/20 transition";
        } else {
          nextBtn.innerHTML = `<span>បន្ទាប់</span> <i class="fa-solid fa-arrow-right"></i>`;
          nextBtn.className = "px-5 py-2.5 rounded-2xl bg-brandGold-600 hover:bg-brandGold-700 text-xs font-bold text-white flex items-center gap-2 shadow-md shadow-amber-500/20 transition";
        }
      }
    }

    function selectQcmAnswer(qIdx, optIdx) {
      userQcmChoices[qIdx] = optIdx;
      const isRight = optIdx === qcmDataset[qIdx].ans;
      playSound(isRight ? 'correct' : 'wrong');

      renderQcmCard(qIdx);
      renderQcmNavGrid();
      updateMetrics();
    }

    function prevQcmStep() {
      if (activeQIdx > 0) {
        activeQIdx--;
        renderQcmCard(activeQIdx);
        renderQcmNavGrid();
      }
    }

    function nextQcmStep() {
      if (activeQIdx < qcmDataset.length - 1) {
        activeQIdx++;
        renderQcmCard(activeQIdx);
        renderQcmNavGrid();
      } else {
        showFinalCertificate();
      }
    }

    function updateMetrics() {
      const answeredTotal = Object.keys(userQcmChoices).length;
      let scoreTotal = 0;
      qcmDataset.forEach((item, idx) => {
        if (userQcmChoices[idx] === item.ans) scoreTotal++;
      });

      const cntEl = document.getElementById('qcmAnsweredCount');
      const scoreEl = document.getElementById('qcmScoreLive');
      const barEl = document.getElementById('qcmProgressBar');

      if (cntEl) cntEl.innerText = answeredTotal;
      if (scoreEl) scoreEl.innerText = `ពិន្ទុ ៖ ${scoreTotal} / 40 (${Math.round((scoreTotal / 40) * 100)}%)`;
      if (barEl) barEl.style.width = `${((activeQIdx + 1) / 40) * 100}%`;
    }

    function showFinalCertificate() {
      let finalScore = 0;
      qcmDataset.forEach((item, idx) => {
        if (userQcmChoices[idx] === item.ans) finalScore++;
      });
      const pct = Math.round((finalScore / 40) * 100);
      const studentName = document.getElementById('studentNameInput').value.trim() || "សិស្សគំរូ ថ្នាក់ទី៦";

      document.getElementById('certStudentNameDisplay').innerText = studentName;
      document.getElementById('certScoreDisplay').innerText = `${finalScore} / 40 (${pct}%)`;

      let gradeText = "និទ្ទេស ៖ ឆ្នើម (Grade A)";
      if (pct < 60) gradeText = "និទ្ទេស ៖ ត្រូវខិតខំប្រឹងប្រែងបន្ថែម (Grade F)";
      else if (pct < 70) gradeText = "និទ្ទេស ៖ ល្អបង្គួរ (Grade D)";
      else if (pct < 80) gradeText = "និទ្ទេស ៖ ល្អ (Grade C)";
      else if (pct < 90) gradeText = "និទ្ទេស ៖ ល្អណាស់ (Grade B)";

      document.getElementById('certGradeBadge').innerText = gradeText;

      const cert = document.getElementById('certificateCard');
      cert.classList.remove('hidden');
      cert.scrollIntoView({ behavior: 'smooth', block: 'start' });

      if (pct >= 60) {
        playSound('fanfare');
        if (typeof confetti === 'function') {
          confetti({ particleCount: 90, spread: 75, origin: { y: 0.6 } });
        }
      }
    }

    function resetAllQcm() {
      userQcmChoices = {};
      activeQIdx = 0;
      renderQcmCard(activeQIdx);
      renderQcmNavGrid();
      updateMetrics();
      startQuizTimer();
      const cert = document.getElementById('certificateCard');
      if (cert) cert.classList.add('hidden');
    }

    // ----------------------------------------------------
    // INITIALIZATION
    // ----------------------------------------------------
    window.addEventListener('DOMContentLoaded', () => {
      initQcmSystem();
    });
  </script>
</body>
</html>