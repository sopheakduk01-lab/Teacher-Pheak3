  <script>
    // ----------------------------------------------------
    // TAB SWITCHING
    // ----------------------------------------------------
    let currentTabId = 'tab-intro';

    function switchTab(tabId) {
      currentTabId = tabId;

      document.querySelectorAll('.tab-panel').forEach(panel => {
        panel.classList.add('hidden');
        panel.classList.remove('block');
      });

      const activeEl = document.getElementById(tabId);
      if (activeEl) {
        activeEl.classList.remove('hidden');
        activeEl.classList.add('block');
      }

      // Top pills
      document.querySelectorAll('.top-nav-btn').forEach(btn => {
        btn.classList.remove('active-top-pill', 'font-bold');
        btn.classList.add('font-semibold', 'text-slate-600', 'dark:text-slate-300');
      });
      const topBtn = document.querySelector(`[data-tab="${tabId}"]`);
      if (topBtn) {
        topBtn.classList.add('active-top-pill', 'font-bold');
        topBtn.classList.remove('text-slate-600', 'dark:text-slate-300');
        topBtn.scrollIntoView({ behavior: 'smooth', inline: 'center', block: 'nearest' });
      }

      // Sidebar
      document.querySelectorAll('.sidebar-btn').forEach(btn => {
        btn.classList.remove('active-sidebar-btn');
        btn.classList.add('text-slate-600', 'dark:text-slate-300');
      });
      const sideBtn = document.querySelector(`[data-side="${tabId}"]`);
      if (sideBtn) {
        sideBtn.classList.add('active-sidebar-btn');
        sideBtn.classList.remove('text-slate-600', 'dark:text-slate-300');
      }

      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function toggleDarkMode() {
      document.documentElement.classList.toggle('dark');
    }

    // ----------------------------------------------------
    // WEB AUDIO API
    // ----------------------------------------------------
    const AudioCtx = window.AudioContext || window.webkitAudioContext;
    const aCtx = AudioCtx ? new AudioCtx() : null;

    function playSound(type) {
      if (!aCtx) return;
      try {
        if (aCtx.state === 'suspended') aCtx.resume();
        const osc = aCtx.createOscillator();
        const gain = aCtx.createGain();
        osc.connect(gain);
        gain.connect(aCtx.destination);

        if (type === 'correct') {
          osc.type = 'triangle';
          osc.frequency.setValueAtTime(523.25, aCtx.currentTime);
          osc.frequency.exponentialRampToValueAtTime(783.99, aCtx.currentTime + 0.15);
          gain.gain.setValueAtTime(0.2, aCtx.currentTime);
          gain.gain.linearRampToValueAtTime(0, aCtx.currentTime + 0.25);
          osc.start();
          osc.stop(aCtx.currentTime + 0.25);
        } else if (type === 'wrong') {
          osc.type = 'sawtooth';
          osc.frequency.setValueAtTime(220, aCtx.currentTime);
          osc.frequency.linearRampToValueAtTime(146.83, aCtx.currentTime + 0.2);
          gain.gain.setValueAtTime(0.2, aCtx.currentTime);
          gain.gain.linearRampToValueAtTime(0, aCtx.currentTime + 0.25);
          osc.start();
          osc.stop(aCtx.currentTime + 0.25);
        } else if (type === 'fanfare') {
          [523.25, 659.25, 783.99, 1046.50].forEach((freq, idx) => {
            const o = aCtx.createOscillator();
            const g = aCtx.createGain();
            o.connect(g);
            g.connect(aCtx.destination);
            o.type = 'sine';
            o.frequency.value = freq;
            g.gain.setValueAtTime(0.15, aCtx.currentTime + idx * 0.08);
            g.gain.linearRampToValueAtTime(0, aCtx.currentTime + 0.5);
            o.start(aCtx.currentTime + idx * 0.08);
            o.stop(aCtx.currentTime + 0.5);
          });
        }
      } catch (e) {}
    }

    // ----------------------------------------------------
    // TEXT-TO-SPEECH
    // ----------------------------------------------------
    let isSpeaking = false;
    function toggleSpeechCurrentTab() {
      if (!('speechSynthesis' in window)) return;
      if (isSpeaking) {
        window.speechSynthesis.cancel();
        isSpeaking = false;
        document.getElementById('ttsBtnText').innerText = "អានសំឡេង";
        return;
      }
      const panel = document.getElementById(currentTabId);
      if (!panel) return;
      const text = panel.innerText.slice(0, 500);

      const u = new SpeechSynthesisUtterance(text);
      u.lang = 'km-KH';
      u.rate = 0.9;
      u.onend = () => { isSpeaking = false; document.getElementById('ttsBtnText').innerText = "អានសំឡេង"; };
      u.onerror = () => { isSpeaking = false; document.getElementById('ttsBtnText').innerText = "អានសំឡេង"; };

      window.speechSynthesis.speak(u);
      isSpeaking = true;
      document.getElementById('ttsBtnText').innerText = "បញ្ឈប់";
    }

    // ----------------------------------------------------
    // INTERACTIVE TOOLS
    // ----------------------------------------------------
    function toggleWordHighlight(btn, isDemonstrative) {
      btn.classList.toggle('demo-adj-highlight');
