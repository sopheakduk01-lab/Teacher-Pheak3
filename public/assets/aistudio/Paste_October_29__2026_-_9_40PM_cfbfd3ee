        }">
          ${item.right}
        </button>
      `).join('');
    }

    function selectSynLeft(id) {
      if (completedSynPairs.has(id)) return;
      activeLeftSynId = id;
      renderSynonymGame();
    }

    function selectSynRight(id) {
      if (!activeLeftSynId || completedSynPairs.has(id)) return;
      if (activeLeftSynId === id) {
        completedSynPairs.add(id);
        playSound('correct');
        activeLeftSynId = null;
        renderSynonymGame();
        if (completedSynPairs.size === synonymsPairs.length) {
