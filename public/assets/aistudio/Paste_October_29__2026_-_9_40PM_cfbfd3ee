            : (activeLeftSynId === item.id ? 'border-brand-500 bg-brand-50 dark:bg-slate-800 ring-2 ring-brand-400' : 'bg-white dark:bg-slate-800 border-slate-200 dark:border-slate-700 hover:border-brand-400')
        }">
          ${item.left}
        </button>
      `).join('');

      // Randomised rights
      const randomizedRights = [...synonymsPairs].sort((a, b) => (a.id * 5 % 7) - (b.id * 5 % 7));
      rightCol.innerHTML = randomizedRights.map(item => `
        <button id="syn-right-${item.id}" onclick="selectSynRight(${item.id})" class="w-full py-2 px-3 rounded-2xl border text-xs font-bold text-center transition ${
