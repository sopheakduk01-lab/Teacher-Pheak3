    function renderSynonymGame() {
      const leftCol = document.getElementById('synLeftBucket');
      const rightCol = document.getElementById('synRightBucket');
      if (!leftCol || !rightCol) return;

      leftCol.innerHTML = synonymsPairs.map(item => `
        <button id="syn-left-${item.id}" onclick="selectSynLeft(${item.id})" class="w-full py-2 px-3 rounded-2xl border text-xs font-bold text-center transition ${
