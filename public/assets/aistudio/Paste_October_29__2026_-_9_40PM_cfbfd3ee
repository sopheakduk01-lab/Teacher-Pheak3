    function pickAlphaWord(idx) {
      const word = currentAlphaSource.splice(idx, 1)[0];
      currentAlphaTarget.push(word);
      renderAlphabetSorter();
    }

    function returnAlphaWord(idx) {
      const word = currentAlphaTarget.splice(idx, 1)[0];
      currentAlphaSource.push(word);
