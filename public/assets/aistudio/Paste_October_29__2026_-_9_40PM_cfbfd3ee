      currentQcmIndex = idx;
      renderSingleQcmStep(currentQcmIndex);
      renderQcmNavGrid();
      const card = document.getElementById("qcmStepCard");
      if (card) card.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }

