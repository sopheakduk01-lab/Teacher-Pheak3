      startQuizTimer();
      updateQcmMetrics();
    }

    function startQuizTimer() {
      if (quizIntervalId) clearInterval(quizIntervalId);
      quizElapsedSecs = 0;
      quizIntervalId = setInterval(() => {
        quizElapsedSecs++;
        const mins = String(Math.floor(quizElapsedSecs / 60)).padStart(2, '0');
        const secs = String(quizElapsedSecs % 60).padStart(2, '0');
        const el = document.getElementById("quizTimerText");
        if (el) el.innerText = `${mins}:${secs}`;
      }, 1000);
    }

    function renderQcmNavGrid() {
      const grid = document.getElementById("qcmGridNav");
      if (!grid) return;
      grid.innerHTML = qcmDataset.map((_, i) => {
        const userChoice = userQcmResponses[i];
        const isAnswered = userChoice !== undefined;
        const isRight = isAnswered && userChoice === qcmDataset[i].ans;
        const isCurrent = i === currentQcmIndex;

        let statusClass = "bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 border-slate-200 dark:border-slate-700";
        if (isAnswered) {
          statusClass = isRight ? "bg-emeraldBrand-500 border-emeraldBrand-600 text-white" : "bg-rose-500 border-rose-600 text-white";
        }

        const ringClass = isCurrent ? "ring-2 ring-brand-500 scale-105" : "";

        return `
          <button id="qcm-nav-btn-${i}" onclick="jumpToQcmQuestion(${i})" class="w-full py-1 rounded-lg text-[11px] font-bold border transition ${statusClass} ${ringClass}">
            ${i + 1}
          </button>
        `;
      }).join('');
    }

