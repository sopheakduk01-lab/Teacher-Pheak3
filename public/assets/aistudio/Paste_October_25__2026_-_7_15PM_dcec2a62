                text = "២. ប្លង់ទេរ (ទំព័រ ៩៣-៩៤)\nក. និយមន័យ៖ ជាផ្ទៃរាបមួយ ដែលជាទូទៅ ធ្វើអំពីបន្ទះឈើឬបន្ទះលោហៈសម្រាប់ប្រើប្រាស់ជាទម្រក្នុងការលើកដាក់វត្ថុពីទីទាបទៅទីខ្ពស់ឬទីខ្ពស់មកទីទាប។\nខ. សារប្រយោជន៍៖ លើកត្រង់ស្មើឬធំជាងបន្ទុក។ លើកតាមប្លង់ទេរតូចជាងបន្ទុក។ ប្រវែងប្លង់ទេរកាន់តែវែង កម្លាំងចលករកាន់តែតូច។\nគ. ប្រភេទឧបករណ៍៖ ពូថៅ រណារ ពន្លាក ផ្លែស្វាន កាំបិត ជណ្តើរ...។";
            } else if (sec === 'pulley') {
                text = "៣. រ៉ក (ទំព័រ ៩៥-៩៦)\nក. និយមន័យ៖ រ៉កគឺជាចង្អូរម៉្យាងធ្វើពីឈើ ឬលោហៈដែលមានចង្អូរជុំវិញសម្រាប់ដាក់ខ្សែពួរ ឬខ្សែលួសនិងមានប្រហោងមួយកាត់តាមផ្ចិតសម្រាប់ដាក់ស្នូលដែលគេហៅថា “អ័ក្ស”។ (ផ្នែកសំខាន់ៗ៖ សម្ពាយ, កង់, អ័ក្ស, ខ្សែ, ចង្អូរ)\nខ. ប្រភេទរ៉ក៖ រ៉កនឹង, រ៉កចល័ត (២រ៉ក), ប្រព័ន្ធរ៉ក (៤រ៉ក)។\nរូបមន្ត៖\n- រ៉កនឹង៖ F = P / 1 (ប្តូរតែទិសដៅ)\n- រ៉កចល័ត៖ F = P / 2 (កាត់បន្ថយកម្លាំង ២ ដង)\n- ប្រព័ន្ធរ៉ក៖ F = P / 4 (កាត់បន្ថយកម្លាំង ៤ ដង)\nសន្និដ្ឋាន៖ ក្នុងការប្រើរ៉ក គេអាចប្រែប្រួលកម្លាំងចលករ ប្រែប្រួលល្បឿន និងទិសនៃកម្លាំង។";
            }
            const temp = document.createElement('textarea');
            temp.value = text;
            document.body.appendChild(temp);
            temp.select();
            document.execCommand('copy');
            document.body.removeChild(temp);
            showToast("បានចម្លងផ្នែកនេះដោយជោគជ័យ!");
        }

        function showToast(msg) {
            const toast = document.getElementById('copy-toast');
            document.getElementById('toast-text').innerText = msg;
            toast.classList.remove('opacity-0', 'pointer-events-none');
            setTimeout(() => {
                toast.classList.add('opacity-0', 'pointer-events-none');
            }, 2300);
        }

        // --- SIMULATOR ENGINE ---
        let currentMode = 'pulley';
        let animActive = true;
        let animOffset = 0;
        const canvas = document.getElementById('simCanvas');
        const ctx = canvas.getContext('2d');

        function toggleAnimation() {
            animActive = !animActive;
            const icon = document.getElementById('anim-icon');
            const text = document.getElementById('anim-text');
            if (animActive) {
                icon.className = 'fa-solid fa-pause';
                text.innerText = 'ផ្អាកចលនា';
            } else {
                icon.className = 'fa-solid fa-play';
                text.innerText = 'បន្តចលនា';
            }
        }

        function setSimMode(mode) {
            currentMode = mode;
            ['lever', 'plane', 'pulley'].forEach(m => {
                const btn = document.getElementById(`btn-mode-${m}`);
                if (m === mode) {
                    btn.className = 'flex-1 py-2 px-3 rounded-xl text-xs font-bold transition flex items-center justify-center gap-1.5 bg-emerald-600 text-white shadow-xs';
                } else {
                    btn.className = 'flex-1 py-2 px-3 rounded-xl text-xs font-bold transition flex items-center justify-center gap-1.5 text-slate-600 hover:text-slate-900';
                }
            });
            renderDynamicControls();
            updateSim();
        }

        function renderDynamicControls() {
            const container = document.getElementById('dynamic-slider-container');
            if (currentMode === 'pulley') {
                container.innerHTML = `
                    <div class="flex justify-between text-xs font-medium text-slate-700">
                        <span>ប្រភេទនៃការតម្លើងរ៉ក៖</span>
                        <span class="font-bold text-emerald-700">ប្រព័ន្ធរ៉ក (៤ រ៉ក)</span>
                    </div>
                    <select id="input-pulley-type" class="w-full bg-white border border-slate-300 text-slate-800 rounded-xl p-2.5 text-xs font-semibold focus:ring-2 focus:ring-emerald-500 focus:outline-none" onchange="updateSim()">
                        <option value="4" selected>ប្រព័ន្ធរ៉ក (៤ រ៉ក) - កាត់បន្ថយកម្លាំង ៤ ដង</option>
                        <option value="2">រ៉កចល័ត (២ រ៉ក) - កាត់បន្ថយកម្លាំង ២ ដង</option>
                        <option value="1">រ៉កនឹង (១ រ៉ក) - ប្តូរតែទិសដៅ F = P</option>
                    </select>
                `;
            } else if (currentMode === 'plane') {
                container.innerHTML = `
                    <div class="flex justify-between text-xs font-medium text-slate-700">
                        <span>ប្រវែងប្លង់ទេរ (L) ធៀបកម្ពស់ (H=2m)៖</span>
                        <span class="font-mono font-bold text-teal-700" id="val-plane-len">4 ម៉ែត្រ</span>
                    </div>
                    <input type="range" id="input-plane-len" min="2" max="10" step="1" value="4" 
                        class="w-full accent-teal-600 h-2 bg-slate-200 rounded-lg cursor-pointer" oninput="updateSim()">
                    <div class="flex justify-between text-[10px] text-slate-500 font-mono">
                        <span>2m (ទេរខ្លាំង)</span>
                        <span>10m (ទេររាបវែង)</span>
                    </div>
                `;
            } else if (currentMode === 'lever') {
                container.innerHTML = `
                    <div class="flex justify-between text-xs font-medium text-slate-700">
                        <span>ប្រវែងដៃកម្លាំងចលករ (សមាមាត្រ)៖</span>
                        <span class="font-mono font-bold text-blue-700" id="val-lever-ratio">2.5 ដង</span>
                    </div>
                    <input type="range" id="input-lever-ratio" min="1" max="5" step="0.5" value="2.5" 
                        class="w-full accent-blue-600 h-2 bg-slate-200 rounded-lg cursor-pointer" oninput="updateSim()">
                    <div class="flex justify-between text-[10px] text-slate-500 font-mono">
                        <span>1x (ស្មើគ្នា)</span>
                        <span>5x (ដៃវែងខ្លាំង)</span>
                    </div>
                `;
            }
        }

        function updateSim() {
            const load = parseFloat(document.getElementById('input-load').value);
            document.getElementById('val-load').innerText = `${load} N`;

            let effort = load;
            let ratioText = "";
            let stepFormula = "";
            let stepValues = "";
            let explanation = "";
            let badgeStatus = "";

            if (currentMode === 'pulley') {
                const count = parseInt(document.getElementById('input-pulley-type').value);
                effort = Math.round(load / count);
                const percent = Math.round((effort / load) * 100);

                if (count === 1) {
                    ratioText = `មិនចំណេញកម្លាំង (១០០%)`;
                    stepFormula = "F = P ÷ ១ (រ៉កនឹងប្តូរតែទិសនៃកម្លាំង)";
                    stepValues = `F = ${load} N ÷ 1 = ${effort} N`;
                    explanation = "រ៉កនឹងគ្រាន់តែជួយប្តូរទិសនៃកម្លាំង (ទាញចុះក្រោម បន្ទុកឡើងលើ) ប៉ុន្តែមិនចំណេញកម្លាំងទេ។";
                    badgeStatus = "រ៉កនឹង៖ F = P";
                } else if (count === 2) {
                    ratioText = `ចំណេញកម្លាំង ២ ដង (${percent}%)`;
                    stepFormula = "F = P ÷ ២ (រ៉កចល័ត ២ រ៉ក)";
                    stepValues = `F = ${load} N ÷ 2 = ${effort} N`;
                    explanation = "រ៉កចល័តជួយសម្រាលកម្លាំងពាក់កណ្តាល៖ កម្លាំងចលករ = បន្ទុក ÷ ២។";
                    badgeStatus = "រ៉កចល័ត៖ កម្លាំងថយ ៥០%";
                } else {
                    ratioText = `ចំណេញកម្លាំង ៤ ដង (${percent}%)`;
                    stepFormula = "F = P ÷ ៤ (ប្រព័ន្ធរ៉ក ៤ រ៉ក)";
                    stepValues = `F = ${load} N ÷ 4 = ${effort} N`;
                    explanation = "ប្រព័ន្ធរ៉កជួយកាត់បន្ថយកម្លាំង ៤ ដង៖ កម្លាំងចលករ = បន្ទុក ÷ ៤។";
                    badgeStatus = "ប្រព័ន្ធរ៉ក៖ កម្លាំងថយ ៧៥%";
                }
                document.getElementById('res-law-label').innerText = "រូបមន្តរ៉ក (ទំព័រ ៩៦)";
            } else if (currentMode === 'plane') {
                const len = parseFloat(document.getElementById('input-plane-len').value);
                document.getElementById('val-plane-len').innerText = `${len} ម៉ែត្រ`;
                const height = 2;
                effort = Math.round((load * height) / len);
                const percent = Math.round((effort / load) * 100);

                ratioText = `កម្លាំងថយមកសល់ ${percent}%`;
                stepFormula = "F = (P × កម្ពស់ H) ÷ ប្រវែងប្លង់ទេរ L";
                stepValues = `F = (${load} N × ${height}m) ÷ ${len}m = ${effort} N`;
                explanation = "បើប្រវែងប្លង់ទេរកាន់តែវែង កម្លាំងចលករកាន់តែតូច។";
                badgeStatus = `ប្លង់ទេរ៖ L = ${len}m, H = 2m`;
                document.getElementById('res-law-label').innerText = "រូបមន្តប្លង់ទេរ (ទំព័រ ៩៤)";
            } else if (currentMode === 'lever') {
                const ratio = parseFloat(document.getElementById('input-lever-ratio').value);
                document.getElementById('val-lever-ratio').innerText = `${ratio} ដង`;
                effort = Math.round(load / ratio);
                const percent = Math.round((effort / load) * 100);

                ratioText = `ចំណេញកម្លាំង ${ratio} ដង (${percent}%)`;
                stepFormula = "F = P ÷ (ប្រវែងដៃចលករ / ដៃបន្ទុក)";
                stepValues = `F = ${load} N ÷ ${ratio} = ${effort} N`;
                explanation = "បើប្រវែងដៃឃ្នាស់កម្លាំងចលករកាន់តែវែង កម្លាំងចលករកាន់តែតូច។";
                badgeStatus = `ឃ្នាស់៖ ដៃវែងជាង ${ratio} ដង`;
                document.getElementById('res-law-label').innerText = "រូបមន្តឃ្នាស់ (ទំព័រ ៩២)";
            }

            document.getElementById('res-effort').innerText = `${effort} N`;
            document.getElementById('res-ratio-badge').innerText = ratioText;
            document.getElementById('calc-step-formula').innerText = stepFormula;
            document.getElementById('calc-step-values').innerText = stepValues;
            document.getElementById('res-explanation').innerText = explanation;
            document.getElementById('canvas-badge-status').innerText = badgeStatus;
        }

        function renderLoop() {
            if (animActive) animOffset += 0.04;
            const w = canvas.width;
            const h = canvas.height;
            ctx.clearRect(0, 0, w, h);

            // Light clean grid
            ctx.strokeStyle = '#e2e8f0';
            ctx.lineWidth = 1;
            for (let x = 0; x < w; x += 30) {
                ctx.beginPath(); ctx.moveTo(x, 0); ctx.lineTo(x, h); ctx.stroke();
            }
            for (let y = 0; y < h; y += 30) {
                ctx.beginPath(); ctx.moveTo(0, y); ctx.lineTo(w, y); ctx.stroke();
            }

            const load = parseFloat(document.getElementById('input-load').value);
            const effortVal = parseFloat(document.getElementById('res-effort').innerText) || 50;

            if (currentMode === 'pulley') {
                drawAnimatedPulley(w, h, load, effortVal, animOffset);
            } else if (currentMode === 'plane') {
                drawAnimatedPlane(w, h, load, effortVal, animOffset);
            } else if (currentMode === 'lever') {
                drawAnimatedLever(w, h, load, effortVal, animOffset);
            }

            requestAnimationFrame(renderLoop);
        }

        function drawAnimatedPulley(w, h, load, effort, t) {
            const count = parseInt(document.getElementById('input-pulley-type').value);
            const cx = w / 2;
            const topY = 55;
            const bob = Math.sin(t) * 14;

            // Ceiling beam
            ctx.fillStyle = '#64748b';
            ctx.fillRect(cx - 110, 10, 220, 10);

            if (count === 1) {
                drawPulleyWheel(cx, topY, 26, '#0284c7');
                ctx.strokeStyle = '#64748b'; ctx.lineWidth = 3;
                ctx.beginPath(); ctx.moveTo(cx, 20); ctx.lineTo(cx, topY); ctx.stroke();

                const loadY = 160 + bob;
                const handY = 170 - bob;
                ctx.strokeStyle = '#d97706'; ctx.lineWidth = 4;
                ctx.beginPath();
                ctx.moveTo(cx - 26, loadY);
                ctx.lineTo(cx - 26, topY);
                ctx.arc(cx, topY, 26, Math.PI, 0, false);
                ctx.lineTo(cx + 45, handY);
                ctx.stroke();

                drawWeightBox(cx - 52, loadY, 52, 36, `${load}N`, '#dc2626');
                drawArrow(cx + 45, handY - 25, cx + 45, handY + 25, `F = ${effort}N`, '#059669', true);
            } else if (count === 2) {
                const lowerY = 150 + bob;
                drawPulleyWheel(cx + 25, topY, 24, '#0284c7');
                ctx.strokeStyle = '#64748b'; ctx.lineWidth = 3;
                ctx.beginPath(); ctx.moveTo(cx + 25, 20); ctx.lineTo(cx + 25, topY); ctx.stroke();

                drawPulleyWheel(cx - 25, lowerY, 22, '#9333ea');
                ctx.strokeStyle = '#d97706'; ctx.lineWidth = 3.5;
                ctx.beginPath();
                ctx.moveTo(cx - 47, 20);
                ctx.lineTo(cx - 47, lowerY);
                ctx.arc(cx - 25, lowerY, 22, Math.PI, 0, true);
                ctx.lineTo(cx + 1, topY);
                ctx.arc(cx + 25, topY, 24, Math.PI, 0, false);
                ctx.lineTo(cx + 70, 185 - bob);
                ctx.stroke();

                drawWeightBox(cx - 52, lowerY + 26, 54, 34, `${load}N`, '#dc2626');
                drawArrow(cx + 70, 150 - bob, cx + 70, 195 - bob, `F = ${effort}N`, '#059669', true);
            } else {
                const lowerY = 145 + bob;
                drawPulleyWheel(cx - 16, topY, 20, '#0284c7');
                drawPulleyWheel(cx + 22, topY, 24, '#0284c7');
                drawPulleyWheel(cx - 16, lowerY, 18, '#9333ea');
                drawPulleyWheel(cx + 18, lowerY, 22, '#9333ea');

                ctx.strokeStyle = '#d97706'; ctx.lineWidth = 3;
                ctx.beginPath();
                ctx.moveTo(cx - 16, 20);
                ctx.lineTo(cx - 16, lowerY);
                ctx.arc(cx - 16, lowerY, 18, Math.PI, 0, true);
                ctx.lineTo(cx - 16, topY);
                ctx.arc(cx - 16, topY, 20, Math.PI, 0, false);
                ctx.lineTo(cx + 18, lowerY);
                ctx.arc(cx + 18, lowerY, 22, Math.PI, 0, true);
                ctx.lineTo(cx + 22, topY);
                ctx.arc(cx + 22, topY, 24, Math.PI, 0, false);
                ctx.lineTo(cx + 75, 185 - bob);
                ctx.stroke();

                drawWeightBox(cx - 35, lowerY + 26, 70, 36, `${load}N`, '#dc2626');
                drawArrow(cx + 75, 140 - bob, cx + 75, 195 - bob, `F = ${effort}N`, '#059669', true);
            }
        }

        function drawAnimatedPlane(w, h, load, effort, t) {
            const len = parseFloat(document.getElementById('input-plane-len').value);
            const startX = 60;
            const groundY = h - 50;
            const topY = 70;
            const endX = startX + (len * 28);

            ctx.strokeStyle = '#94a3b8'; ctx.lineWidth = 3;
            ctx.beginPath(); ctx.moveTo(20, groundY); ctx.lineTo(w - 20, groundY); ctx.stroke();

            ctx.fillStyle = '#f1f5f9';
            ctx.beginPath(); ctx.moveTo(startX, groundY); ctx.lineTo(endX, groundY); ctx.lineTo(endX, topY); ctx.closePath(); ctx.fill();

            ctx.strokeStyle = '#0284c7'; ctx.lineWidth = 4;
            ctx.beginPath(); ctx.moveTo(startX, groundY); ctx.lineTo(endX, topY); ctx.stroke();

