                                <button onclick="handleSelectStepAnswer(${optIdx})" 
                                    class="w-full text-left p-3.5 rounded-xl border text-xs sm:text-sm transition duration-150 active:scale-[0.99] flex items-start gap-3 ${btnStyle}">
                                    <span class="font-mono font-bold px-2 py-0.5 rounded-md bg-white border border-slate-200 shrink-0 text-slate-800">
                                        ${['ក.', 'ខ.', 'គ.', 'ឃ.'][optIdx]}
                                    </span>
                                    <span class="flex-grow pt-0.5">${opt}</span>
                                    ${iconState}
                                </button>
                            `;
                        }).join('')}
                    </div>

                    <div class="text-xs sm:text-sm p-4 rounded-xl ${hasAnswered ? '' : 'hidden'} ${hasAnswered ? (selectedOpt === item.correct ? 'bg-emerald-50 border border-emerald-200 text-emerald-950' : 'bg-rose-50 border border-rose-200 text-rose-950') : ''}">
                        ${hasAnswered ? (selectedOpt === item.correct 
                            ? `<div class="flex items-start gap-2.5"><i class="fa-solid fa-circle-check text-emerald-600 mt-0.5 text-base"></i><div><strong>ចម្លើយត្រឹមត្រូវ!</strong> ${item.exp}</div></div>` 
                            : `<div class="flex items-start gap-2.5"><i class="fa-solid fa-circle-xmark text-rose-600 mt-0.5 text-base"></i><div><strong>ចម្លើយមិនទាន់ត្រឹមត្រូវទេ!</strong> ${item.exp}</div></div>`) : ''}
                    </div>
                </div>
            `;

            renderQuickNavigator();
            updateScoreBadge();
        }

        function handleSelectStepAnswer(optIdx) {
            userAnswers[currentQIndex] = optIdx;
            renderStepQuestion();
        }

        function nextQuestion() {
            if (currentQIndex < qcmDatabase.length - 1) {
                currentQIndex++;
                renderStepQuestion();
            }
        }

        function prevQuestion() {
            if (currentQIndex > 0) {
                currentQIndex--;
                renderStepQuestion();
            }
        }

        function jumpToQuestion(idx) {
            currentQIndex = idx;
            renderStepQuestion();
        }

        function renderQuickNavigator() {
            const nav = document.getElementById('quiz-number-navigator');
            nav.innerHTML = qcmDatabase.map((item, idx) => {
                const hasAnswered = userAnswers.hasOwnProperty(idx);
                let bg = "bg-slate-100 text-slate-700 hover:bg-slate-200";
                let ring = (idx === currentQIndex) ? "ring-2 ring-emerald-500 font-bold" : "";

                if (hasAnswered) {
                    if (userAnswers[idx] === item.correct) {
                        bg = "bg-emerald-600 text-white font-semibold";
                    } else {
                        bg = "bg-rose-500 text-white font-semibold";
                    }
                }

                return `
                    <button onclick="jumpToQuestion(${idx})" class="w-full py-1.5 rounded-lg text-xs font-mono transition text-center ${bg} ${ring}">
                        ${idx + 1}
                    </button>
                `;
            }).join('');
        }

        function updateScoreBadge() {
            let correct = 0;
            qcmDatabase.forEach((item, idx) => {
                if (userAnswers[idx] === item.correct) {
                    correct++;
                }
            });
            document.getElementById('quiz-score-badge').innerText = correct;
        }

        function resetQuiz() {
            userAnswers = {};
            currentQIndex = 0;
            renderStepQuestion();
        }

        // Initialize on page load
        window.onload = function() {
            renderDynamicControls();
            resizeCanvas();
            renderStepQuestion();
            renderLoop();
        };
    </script>
</body>
</html>