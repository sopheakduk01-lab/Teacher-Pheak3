                text = "៥. បណ្តាញអគ្គិសនីក្នុងគេហដ្ឋាន (ទំព័រ ១០៦-១០៧)\n- តជាខ្នែង៖ បើខូចមួយ គ្រឿងទទួលដទៃទៀតនៅតែដំណើរការធម្មតា\n- ភុយស៊ីប៖ ជាខ្សែស្តើងងាយរលាយដាច់ពេលឆ្លងកាត់កម្ដៅខ្លាំង\n- ឌីសុងទ័រ៖ ជាកុងតាក់ស្វ័យប្រវត្តិកាត់ផ្តាច់ពេលលើសបន្ទុក\n- កុងទ័រអគ្គិសនី៖ វាស់ថាមពលអគ្គិសនីគិតជា គីឡូវ៉ាត់ម៉ោង (kW/h)\n- កុងតាក់៖ ភ្ជាប់ឬផ្តាច់ចរន្ត\n- ព្រី និងឌុយ៖ សម្រាប់ដោតភ្ជាប់ចរន្ត។";
            }
            const temp = document.createElement('textarea');
            temp.value = text;
            document.body.appendChild(temp);
            temp.select();
            document.execCommand('copy');
            document.body.removeChild(temp);
            showToast("បានចម្លងផ្នែកនេះដោយជោគជ័យ!");
        }

        function showToast(msg) {
            const toast = document.getElementById('copy-toast');
            document.getElementById('toast-text').innerText = msg;
            toast.classList.remove('opacity-0', 'pointer-events-none');
            setTimeout(() => {
                toast.classList.add('opacity-0', 'pointer-events-none');
            }, 2300);
        }

        // ==========================================
        // SIMULATOR ENGINE (CIRCUIT LAB)
        // ==========================================
        let simMode = 'conductor_test'; // 'conductor_test' or 'series_parallel'
        let switchClosed = true;
        let animActive = true;
        let electronOffset = 0;
        const canvas = document.getElementById('simCanvas');
        const ctx = canvas.getContext('2d');

        // State for Conductor Test Mode
        let selectedMaterial = 'iron_nail'; // 'iron_nail', 'paperclip', 'wood', 'pencil_lead', 'salt_water', 'paper'
        let batteryCount = 1; // 1, 2, 3 batteries (1.5V each)

        // State for Series / Parallel Mode
        let circuitType = 'parallel'; // 'series' or 'parallel'
        let bulb1Broken = false;
        let bulb2Broken = false;

        const materialData = {
            'iron_nail': { name: 'ដែកគោល', isConductor: true, icon: 'fa-solid fa-screwdriver', color: '#64748b', desc: 'ជាលោហៈចម្លងអគ្គិសនីបានល្អ' },
            'paperclip': { name: 'ស្នៀតក្រដាស', isConductor: true, icon: 'fa-solid fa-paperclip', color: '#94a3b8', desc: 'ជាលោហៈចម្លងអគ្គិសនីបានល្អ' },
            'pencil_lead': { name: 'បណ្តូលខ្មៅដៃ (ក្រាហ្វិត)', isConductor: true, icon: 'fa-solid fa-pencil', color: '#334155', desc: 'ជាតិកាបូន (ក្រាហ្វិត) ចម្លងអគ្គិសនីបាន' },
            'salt_water': { name: 'ទឹកអំបិល', isConductor: true, icon: 'fa-solid fa-glass-water', color: '#38bdf8', desc: 'សូលុយស្យុងអ៊ីយ៉ុងចម្លងអគ្គិសនីបាន' },
            'wood': { name: 'ឈើ', isConductor: false, icon: 'fa-solid fa-tree', color: '#b45309', desc: 'ជាអ៊ីសូឡង់ មិនឱ្យចរន្តអគ្គិសនីឆ្លងកាត់' },
            'paper': { name: 'ក្រដាសសៀវភៅ', isConductor: false, icon: 'fa-solid fa-sheet-plastic', color: '#cbd5e1', desc: 'ជាអ៊ីសូឡង់ មិនឱ្យចរន្តអគ្គិសនីឆ្លងកាត់' }
        };

        function setSimMode(mode) {
            simMode = mode;
            ['conductor_test', 'series_parallel'].forEach(m => {
                const btn = document.getElementById(`btn-mode-${m}`);
                if (m === mode) {
                    btn.className = 'flex-1 py-2 px-3 rounded-xl text-xs font-bold transition flex items-center justify-center gap-1.5 bg-amber-600 text-white shadow-xs';
                } else {
                    btn.className = 'flex-1 py-2 px-3 rounded-xl text-xs font-bold transition flex items-center justify-center gap-1.5 text-slate-600 hover:text-slate-900';
                }
            });
            renderDynamicControls();
            updateSim();
        }

        function toggleSwitch() {
            switchClosed = !switchClosed;
            const btn = document.getElementById('btn-switch-toggle');
            const txt = document.getElementById('switch-text');
            if (switchClosed) {
                btn.className = 'bg-amber-600 hover:bg-amber-700 text-white px-3.5 py-1.5 rounded-xl text-xs font-bold transition active:scale-95 shadow-xs flex items-center gap-1.5';
                txt.innerText = 'ចុចកាត់ផ្តាច់កុងតាក់';
            } else {
                btn.className = 'bg-rose-600 hover:bg-rose-700 text-white px-3.5 py-1.5 rounded-xl text-xs font-bold transition active:scale-95 shadow-xs flex items-center gap-1.5';
                txt.innerText = 'ចុចភ្ជាប់កុងតាក់ (បិទ)';
            }
            updateSim();
        }

        function toggleAnimation() {
            animActive = !animActive;
            const icon = document.getElementById('anim-icon');
            const text = document.getElementById('anim-text');
            if (animActive) {
                icon.className = 'fa-solid fa-pause';
                text.innerText = 'ផ្អាក';
            } else {
                icon.className = 'fa-solid fa-play';
                text.innerText = 'បន្ត';
            }
        }

        function renderDynamicControls() {
            const host = document.getElementById('dynamic-controls-host');
            if (simMode === 'conductor_test') {
                host.innerHTML = `
                    <div class="space-y-2">
                        <label class="block text-xs font-medium text-slate-700">ជ្រើសរើសអង្គធាតុតេស្ត (ទំព័រ ១០២)៖</label>
                        <select id="select-material" class="w-full bg-white border border-slate-300 text-slate-800 rounded-xl p-2.5 text-xs font-semibold focus:ring-2 focus:ring-amber-500 focus:outline-none" onchange="handleMaterialChange(this.value)">
                            <option value="iron_nail" ${selectedMaterial === 'iron_nail' ? 'selected' : ''}>ដែកគោល (ចម្លងអគ្គិសនី)</option>
                            <option value="paperclip" ${selectedMaterial === 'paperclip' ? 'selected' : ''}>ស្នៀតក្រដាស (ចម្លងអគ្គិសនី)</option>
                            <option value="pencil_lead" ${selectedMaterial === 'pencil_lead' ? 'selected' : ''}>បណ្តូលខ្មៅដៃ (ចម្លងអគ្គិសនី)</option>
                            <option value="salt_water" ${selectedMaterial === 'salt_water' ? 'selected' : ''}>ទឹកអំបិល (ចម្លងអគ្គិសនី)</option>
                            <option value="wood" ${selectedMaterial === 'wood' ? 'selected' : ''}>ឈើ (អ៊ីសូឡង់)</option>
                            <option value="paper" ${selectedMaterial === 'paper' ? 'selected' : ''}>ក្រដាសសៀវភៅ (អ៊ីសូឡង់)</option>
                        </select>
                    </div>

                    <div class="space-y-2 pt-2 border-t border-slate-200">
                        <div class="flex justify-between text-xs font-medium text-slate-700">
                            <span>ចំនួនថ្មពិល (1.5V ក្នុងមួយដុំ)៖</span>
                            <span class="font-mono font-bold text-amber-700" id="val-battery-label">${batteryCount} គ្រាប់ (${(batteryCount * 1.5).toFixed(1)}V)</span>
                        </div>
                        <input type="range" id="input-battery-count" min="1" max="3" step="1" value="${batteryCount}" 
