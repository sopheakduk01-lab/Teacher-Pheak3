            ctx.fillStyle = mat.isConductor ? '#059669' : '#dc2626';
            ctx.font = 'bold 11px Kantumruy Pro';
            ctx.textAlign = 'center';
            ctx.fillText(`${mat.name} (${mat.isConductor ? 'ចម្លង' : 'អ៊ីសូឡង់'})`, 0, -22);

            ctx.restore();
        }

        // Helper Graphic: Moving Electrons
        function drawFlowingElectrons(lx, ty, rx, by, midX, offset) {
            ctx.fillStyle = '#38bdf8';
            const spacing = 35;
            const radius = 3;

            // Draw along rectangle perimeter
            // Perimeter segments: Top (lx to rx), Right (ty to by), Bot (rx to lx), Left (by to ty)
            const perimeter = (rx - lx) * 2 + (by - ty) * 2;
            const count = Math.floor(perimeter / spacing);

            for (let i = 0; i < count; i++) {
                let dist = (i * spacing + offset) % perimeter;
                let px = 0, py = 0;

                if (dist < (rx - lx)) {
                    // Top edge (Moving Left-to-Right for current, but electrons run opposite! We show electron flow from - to +)
                    px = rx - dist;
                    py = ty;
                } else if (dist < (rx - lx) + (by - ty)) {
                    let d = dist - (rx - lx);
                    px = lx;
                    py = ty + d;
                } else if (dist < (rx - lx) * 2 + (by - ty)) {
                    let d = dist - ((rx - lx) + (by - ty));
                    px = lx + d;
                    py = by;
                } else {
                    let d = dist - ((rx - lx) * 2 + (by - ty));
                    px = rx;
                    py = by - d;
                }

                ctx.beginPath();
                ctx.arc(px, py, radius, 0, Math.PI * 2);
                ctx.fill();
            }
        }

        function drawDirectionArrows(lx, ty, rx, by) {
            // Conventional current arrow on top wire (Red, pointing right)
            drawArrowHead(rx - 60, ty, 0, '#ef4444', "ទិសចរន្ត (+)");
            // Electron flow arrow on bottom wire (Blue, pointing right)
            drawArrowHead(lx + 60, by, 0, '#0284c7', "ទិសអេឡិចត្រុង (-)");
        }

        function drawArrowHead(x, y, angle, color, label) {
            ctx.save();
            ctx.translate(x, y);
            ctx.rotate(angle);
            ctx.fillStyle = color;
            ctx.beginPath();
            ctx.moveTo(8, 0); ctx.lineTo(-4, -5); ctx.lineTo(-4, 5); ctx.closePath();
            ctx.fill();

            if (label) {
                ctx.font = 'bold 9px Kantumruy Pro';
                ctx.textAlign = 'center';
                ctx.fillText(label, 0, -8);
            }
            ctx.restore();
        }

