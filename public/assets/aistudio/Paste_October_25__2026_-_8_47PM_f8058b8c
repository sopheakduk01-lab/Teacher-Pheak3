                        <div class="flex justify-between text-[10px] text-slate-500 font-mono">
                            <span>1 ដុំ (1.5V)</span>
                            <span>2 ដុំ (3.0V)</span>
                            <span>3 ដុំ (4.5V)</span>
                        </div>
                    </div>
                `;
            } else {
                host.innerHTML = `
                    <div class="space-y-2">
                        <label class="block text-xs font-medium text-slate-700">ប្រភេទសៀគ្វីគ្រឿងទទួល (ទំព័រ ១០៥)៖</label>
                        <div class="grid grid-cols-2 gap-2">
                            <button onclick="setCircuitType('parallel')" class="py-2 px-3 rounded-xl text-xs font-bold border transition ${circuitType === 'parallel' ? 'bg-amber-600 text-white border-amber-600' : 'bg-white text-slate-700 border-slate-300'}">
                                សៀគ្វីជាខ្នែង (ផ្ទះ)
                            </button>
                            <button onclick="setCircuitType('series')" class="py-2 px-3 rounded-xl text-xs font-bold border transition ${circuitType === 'series' ? 'bg-amber-600 text-white border-amber-600' : 'bg-white text-slate-700 border-slate-300'}">
                                សៀគ្វីជាស៊េរី
                            </button>
                        </div>
                    </div>

                    <div class="space-y-2 pt-3 border-t border-slate-200">
                        <label class="block text-xs font-medium text-slate-700">ពិសោធន៍ដោះអំពូលចេញ (Bulb Disconnect)៖</label>
                        <div class="space-y-2">
                            <button onclick="toggleBulb(1)" id="btn-bulb1" class="w-full text-left p-2.5 rounded-xl border text-xs font-semibold flex items-center justify-between ${bulb1Broken ? 'bg-rose-50 text-rose-700 border-rose-300' : 'bg-white text-slate-700 border-slate-300'}">
                                <span><i class="fa-regular fa-lightbulb mr-2"></i> អំពូលទី ១</span>
                                <span class="text-[10px] px-2 py-0.5 rounded ${bulb1Broken ? 'bg-rose-200 text-rose-900' : 'bg-emerald-100 text-emerald-800'}">${bulb1Broken ? 'ដោះចេញ / ខូច' : 'កំពុងតភ្ជាប់'}</span>
                            </button>
                            <button onclick="toggleBulb(2)" id="btn-bulb2" class="w-full text-left p-2.5 rounded-xl border text-xs font-semibold flex items-center justify-between ${bulb2Broken ? 'bg-rose-50 text-rose-700 border-rose-300' : 'bg-white text-slate-700 border-slate-300'}">
                                <span><i class="fa-regular fa-lightbulb mr-2"></i> អំពូលទី ២</span>
                                <span class="text-[10px] px-2 py-0.5 rounded ${bulb2Broken ? 'bg-rose-200 text-rose-900' : 'bg-emerald-100 text-emerald-800'}">${bulb2Broken ? 'ដោះចេញ / ខូច' : 'កំពុងតភ្ជាប់'}</span>
                            </button>
                        </div>
                    </div>
                `;
