    <title>មេរៀនទី ១៥៖ អគ្គិសនី (Electricity) - សៀវភៅពុម្ពទំព័រ ១០០-១០៧</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Google Khmer Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Kantumruy+Pro:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&family=Moul&family=JetBrains+Mono:wght@400;600;700&display=swap" rel="stylesheet">
