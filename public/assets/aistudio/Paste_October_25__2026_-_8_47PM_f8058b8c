        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        khmer: ['"Kantumruy Pro"', 'sans-serif'],
                        moul: ['"Moul"', 'serif'],
                        mono: ['"JetBrains Mono"', 'monospace']
                    },
                    colors: {
                        amberElectric: {
                            50: '#fffbeb',
                            100: '#fef3c7',
                            200: '#fde68a',
                            500: '#f59e0b',
                            600: '#d97706',
                            700: '#b45309',
                        }
                    }
                }
            }
        }
    </script>
    <style>
        body {
            font-family: 'Kantumruy Pro', sans-serif;
            -webkit-tap-highlight-color: transparent;
            background-color: #ffffff;
        }

        .canvas-container canvas {
            display: block;
            width: 100%;
            height: 320px;
        }
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        ::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 9999px;
        }
        @keyframes pulseGlow {
            0%, 100% { opacity: 0.9; transform: scale(1); }
            50% { opacity: 1; transform: scale(1.05); }
        }
        .animate-glow {
            animation: pulseGlow 2s infinite ease-in-out;
        }
    </style>
</head>
<body class="text-slate-800 antialiased min-h-screen flex flex-col font-khmer selection:bg-amber-500 selection:text-white bg-white">

    <!-- Top Navigation Bar -->
    <header class="sticky top-0 z-50 bg-white border-b border-slate-200 shadow-sm">
        <div class="max-w-6xl mx-auto px-4 py-3 flex items-center justify-between">
            <div class="flex items-center space-x-3">
                <div class="w-11 h-11 rounded-2xl bg-gradient-to-tr from-amber-500 via-orange-500 to-yellow-400 flex items-center justify-center text-white shadow-md shadow-amber-500/20 ring-2 ring-amber-100">
                    <i class="fa-solid fa-bolt-lightning text-xl"></i>
                </div>
                <div>
                    <div class="flex items-center gap-2">
                        <span class="text-[10px] font-bold px-2.5 py-0.5 rounded-full bg-amber-50 text-amber-800 border border-amber-200">រូបវិទ្យាថ្នាក់ទី ៧-៨</span>
                        <span class="text-[10px] text-slate-500 hidden sm:inline"><i class="fa-solid fa-book-bookmark mr-1 text-amber-600"></i>សៀវភៅពុម្ព MoEYS (ទំព័រ ១០០-១០៧)</span>
                    </div>
                    <h1 class="text-base sm:text-lg font-bold text-slate-900 leading-tight">មេរៀនទី ១៥៖ អគ្គិសនី (Electricity)</h1>
                </div>
            </div>

            <div class="flex items-center space-x-2">
                <button onclick="copyFullLesson()" class="flex items-center space-x-1.5 bg-white hover:bg-slate-50 active:scale-95 text-slate-700 px-3.5 py-2 rounded-xl text-xs font-semibold transition border border-slate-300 shadow-xs">
                    <i class="fa-regular fa-clipboard text-amber-600 text-sm"></i>
                    <span class="hidden sm:inline">ចម្លងមេរៀន</span>
                    <span class="sm:hidden">ចម្លង</span>
                </button>
            </div>
        </div>
        
        <!-- Navigation Tabs -->
        <nav class="max-w-6xl mx-auto px-4 flex space-x-2 border-t border-slate-200/80 overflow-x-auto text-xs sm:text-sm py-2">
            <button onclick="switchTab('overview')" id="tab-overview" class="tab-btn py-2 px-3.5 rounded-xl font-semibold text-amber-800 bg-amber-50 border border-amber-300 whitespace-nowrap flex items-center space-x-2 transition shadow-xs">
                <i class="fa-solid fa-layer-group text-amber-600"></i> <span>១. ខ្លឹមសារ ៥ ផ្នែក (Step-by-Step)</span>
            </button>
            <button onclick="switchTab('simulation')" id="tab-simulation" class="tab-btn py-2 px-3.5 rounded-xl font-medium text-slate-600 hover:text-slate-900 hover:bg-slate-100 border border-transparent whitespace-nowrap flex items-center space-x-2 transition">
                <i class="fa-solid fa-flask-vial text-slate-500"></i> <span>២. បន្ទប់ពិសោធន៍សៀគ្វី (Circuit Lab)</span>
            </button>
            <button onclick="switchTab('quiz')" id="tab-quiz" class="tab-btn py-2 px-3.5 rounded-xl font-medium text-slate-600 hover:text-slate-900 hover:bg-slate-100 border border-transparent whitespace-nowrap flex items-center space-x-2 transition">
                <i class="fa-solid fa-list-check text-slate-500"></i> <span>៣. សំណួរ QCM (៤០ សំណួរ)</span>
            </button>
        </nav>
    </header>

    <!-- Main Content Container -->
    <main class="flex-grow max-w-6xl w-full mx-auto p-4 sm:p-6 pb-24">

        <!-- TAB 1: STEP-BY-STEP LESSON (5 MODULES) -->
        <section id="panel-overview" class="space-y-6">

            <!-- Banner info -->
            <div class="bg-slate-50 p-6 rounded-3xl border border-slate-200 shadow-sm relative overflow-hidden">
                <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 relative z-10">
                    <div class="space-y-1.5">
                        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-50 border border-amber-200 text-amber-800 text-xs font-bold">
                            <i class="fa-solid fa-book-open text-amber-600"></i> ខ្លឹមសារសៀវភៅពុម្ពក្រសួងអប់រំ (ទំព័រ ១០០ ដល់ ១០៧)
                        </div>
                        <h2 class="text-xl sm:text-2xl font-bold text-slate-900">ជំពូកទី ៥ • មេរៀនទី ១៥៖ អគ្គិសនី</h2>
                        <p class="text-xs sm:text-sm text-slate-600">ខ្លឹមសារលម្អិតបែងចែកជា ៥ ជំហានច្បាស់លាស់ ងាយស្រួលយល់ និងកត់ត្រា</p>
                    </div>
                    <div class="flex items-center gap-2">
                        <button onclick="copyFullLesson()" class="bg-amber-600 hover:bg-amber-700 active:scale-95 text-white text-xs font-bold px-4 py-2.5 rounded-xl shadow-sm transition flex items-center gap-2">
                            <i class="fa-solid fa-copy"></i> ចម្លងអត្ថបទទាំងអស់
                        </button>
                    </div>
                </div>
            </div>

            <!-- STEP 1: ចរន្តអគ្គិសនី និងទិសដៅ -->
            <div class="bg-white rounded-3xl border border-slate-200 shadow-sm overflow-hidden">
                <div class="bg-slate-50/80 border-b border-slate-200 px-6 py-4 flex items-center justify-between">
                    <div class="flex items-center space-x-3">
                        <span class="w-10 h-10 rounded-2xl bg-amber-500 text-white font-bold text-base flex items-center justify-center shadow-sm">១</span>
                        <div>
                            <div class="text-[11px] font-bold text-amber-700 tracking-wider uppercase">ជំហានទី ១ (Step 1)</div>
                            <h3 class="font-bold text-slate-900 text-base sm:text-lg">ចរន្តអគ្គិសនី និងទិសដៅចរន្ត (ទំព័រ ១០០-១០១)</h3>
                        </div>
                    </div>
                    <button onclick="copySection('current')" class="text-xs bg-white hover:bg-slate-100 text-slate-700 px-3 py-1.5 rounded-xl border border-slate-200 flex items-center gap-1.5 shadow-xs">
                        <i class="fa-regular fa-copy text-slate-500"></i> <span>ចម្លងផ្នែកនេះ</span>
                    </button>
                </div>

                <div class="p-6 space-y-6 text-sm text-slate-700 leading-relaxed">
                    <!-- ប្រភពអគ្គិសនី -->
                    <div class="space-y-2">
                        <h4 class="font-bold text-slate-900 flex items-center gap-2">
                            <span class="w-2.5 h-2.5 rounded-full bg-amber-500"></span> ក. ប្រភពអគ្គិសនី (ទំព័រ ១០០)
                        </h4>
                        <div class="p-4 bg-slate-50 rounded-2xl border border-slate-200 text-slate-800 space-y-2">
                            <p>ចរន្តអគ្គិសនីដែលយើងកំពុងប្រើប្រាស់សព្វថ្ងៃ បានមកពីប្រភពអគ្គិសនីពីរគឺ <strong>ប្រភពចរន្តជាប់</strong> និង <strong>ប្រភពចរន្តឆ្លាស់</strong>។ ប្រភពផ្តល់ចរន្តអគ្គិសនីទាំងពីរនេះហៅថា <strong>ដីណាម៉ូ ឬជនិតាអគ្គិសនី</strong>។</p>
                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-2">
                                <div class="p-3 bg-white rounded-xl border border-slate-200">
                                    <div class="text-xs font-bold text-amber-700">១. ជនិតាចរន្តឆ្លាស់</div>
                                    <div class="text-xs text-slate-600 mt-1">ឌីណាម៉ូ, អាល់ទែណាទ័រ...</div>
                                </div>
                                <div class="p-3 bg-white rounded-xl border border-slate-200">
                                    <div class="text-xs font-bold text-amber-700">២. ជនិតាចរន្តជាប់</div>
                                    <div class="text-xs text-slate-600 mt-1">ថ្មពិល, អាគុយ...</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- និយមន័យចរន្តអគ្គិសនី -->
                    <div class="space-y-2">
                        <h4 class="font-bold text-slate-900 flex items-center gap-2">
                            <span class="w-2.5 h-2.5 rounded-full bg-amber-500"></span> ខ. និយមន័យចរន្តអគ្គិសនី
                        </h4>
                        <p class="text-slate-700">
                            នៅក្នុងខ្សែចម្លងមានបន្ទុកអគ្គិសនីឬអេឡិចត្រុងសេរីយ៉ាងច្រើន ធ្វើចលនាឥតឈប់ឈរនិងគ្មានសណ្តាប់ធ្នាប់។ នៅពេលយើងភ្ជាប់ខ្សែចម្លងទៅនឹងប្រភព (ជនិតា) កម្លាំងចលករអគ្គិសនីបានរុញបន្ទុកអគ្គិសនីឬអេឡិចត្រុងសេរីទាំងនោះឱ្យផ្លាស់ទីតាមទិសដៅតែមួយ។
                        </p>
                        <div class="p-3.5 bg-amber-50 border border-amber-200 rounded-2xl text-amber-950 font-semibold text-xs sm:text-sm">
                            <i class="fa-solid fa-quote-left text-amber-600 mr-1.5"></i> <strong>ដូចនេះ៖</strong> ចរន្តអគ្គិសនី គឺជាបម្លាស់បន្ទុកអគ្គិសនីឬអេឡិចត្រុង។
                        </div>
                    </div>

                    <!-- ទិសដៅចរន្តអគ្គិសនី -->
                    <div class="space-y-2">
                        <h4 class="font-bold text-slate-900 flex items-center gap-2">
                            <span class="w-2.5 h-2.5 rounded-full bg-amber-500"></span> គ. ទិសដៅចរន្តអគ្គិសនី និងអេឡិចត្រុង (ទំព័រ ១០១)
                        </h4>
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-3 text-xs">
                            <div class="p-4 bg-slate-50 rounded-2xl border border-slate-200 space-y-1.5">
                                <div class="font-bold text-rose-700 text-sm flex items-center justify-between">
                                    <span>ទិសដៅចរន្តអគ្គិសនី (តាមទម្លាប់)</span>
                                    <span class="text-[10px] px-2 py-0.5 rounded bg-rose-100 text-rose-800 border border-rose-200">(+) ទៅ (-)</span>
                                </div>
                                <p class="text-slate-600">ចរន្តអគ្គិសនីផ្លាស់ទីពី <strong>ប៉ូលវិជ្ជមាន (+)</strong> ឆ្លងកាត់អំពូល រួចទៅ <strong>ប៉ូលអវិជ្ជមាន (-)</strong>។</p>
                            </div>
                            <div class="p-4 bg-slate-50 rounded-2xl border border-slate-200 space-y-1.5">
                                <div class="font-bold text-blue-700 text-sm flex items-center justify-between">
                                    <span>ទិសដៅបម្លាស់ទីអេឡិចត្រុង</span>
                                    <span class="text-[10px] px-2 py-0.5 rounded bg-blue-100 text-blue-800 border border-blue-200">(-) ទៅ (+)</span>
                                </div>
                                <p class="text-slate-600">រីឯអេឡិចត្រុង ផ្លាស់ទីក្នុងខ្សែចម្លងពី <strong>ប៉ូលអវិជ្ជមាន (-)</strong> ទៅ <strong>ប៉ូលវិជ្ជមាន (+)</strong> (ទិសដៅផ្ទុយពីចរន្ត)។</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- STEP 2: ឧបករណ៍វាស់ (អំពែម៉ែត្រ និងវ៉ុលម៉ែត្រ) -->
            <div class="bg-white rounded-3xl border border-slate-200 shadow-sm overflow-hidden">
                <div class="bg-slate-50/80 border-b border-slate-200 px-6 py-4 flex items-center justify-between">
                    <div class="flex items-center space-x-3">
                        <span class="w-10 h-10 rounded-2xl bg-cyan-600 text-white font-bold text-base flex items-center justify-center shadow-sm">២</span>
                        <div>
                            <div class="text-[11px] font-bold text-cyan-700 tracking-wider uppercase">ជំហានទី ២ (Step 2)</div>
                            <h3 class="font-bold text-slate-900 text-base sm:text-lg">ឧបករណ៍វាស់អគ្គិសនី (ទំព័រ ១០១)</h3>
                        </div>
                    </div>
                    <button onclick="copySection('meters')" class="text-xs bg-white hover:bg-slate-100 text-slate-700 px-3 py-1.5 rounded-xl border border-slate-200 flex items-center gap-1.5 shadow-xs">
                        <i class="fa-regular fa-copy text-slate-500"></i> <span>ចម្លងផ្នែកនេះ</span>
                    </button>
                </div>

                <div class="p-6 space-y-6 text-sm text-slate-700 leading-relaxed">
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <!-- អំពែម៉ែត្រ -->
                        <div class="bg-slate-50 p-5 rounded-2xl border border-slate-200 space-y-3">
                            <div class="flex items-center justify-between">
                                <h4 class="font-bold text-slate-900 text-sm flex items-center gap-2">
                                    <span class="w-2.5 h-2.5 rounded-full bg-cyan-600"></span> អំពែម៉ែត្រ (Ammeter)
                                </h4>
                                <span class="text-xs font-mono px-2 py-0.5 rounded bg-cyan-100 text-cyan-800 font-bold">A</span>
                            </div>
                            <p class="text-xs text-slate-600">ឧបករណ៍វាស់អាំងតង់ស៊ីតេចរន្តអគ្គិសនី ហៅថា <strong>អំពែម៉ែត្រ</strong>។</p>
                            <ul class="text-xs space-y-1 text-slate-700 list-disc list-inside">
                                <li>ខ្នាតចរន្តអគ្គិសនីគឺ៖ <strong>អំពែ (A)</strong></li>
                                <li>ខ្នាតដែលតូចជាងគឺ៖ <strong>មីលីអំពែ (mA)</strong></li>
                            </ul>
                            <div class="p-2.5 bg-white rounded-xl border border-slate-200 text-center font-mono text-xs font-bold text-cyan-800">
                                1A = 1000 mA
                            </div>
                        </div>

                        <!-- វ៉ុលម៉ែត្រ -->
                        <div class="bg-slate-50 p-5 rounded-2xl border border-slate-200 space-y-3">
                            <div class="flex items-center justify-between">
                                <h4 class="font-bold text-slate-900 text-sm flex items-center gap-2">
                                    <span class="w-2.5 h-2.5 rounded-full bg-indigo-600"></span> វ៉ុលម៉ែត្រ (Voltmeter)
                                </h4>
                                <span class="text-xs font-mono px-2 py-0.5 rounded bg-indigo-100 text-indigo-800 font-bold">V</span>
                            </div>
                            <p class="text-xs text-slate-600">ឧបករណ៍វាស់កម្លាំងអគ្គិសនីចលករ ឬតង់ស្យុង ហៅថា <strong>វ៉ុលម៉ែត្រ</strong>។</p>
                            <ul class="text-xs space-y-1 text-slate-700 list-disc list-inside">
                                <li>ខ្នាតកម្លាំងអគ្គិសនីចលករគឺ៖ <strong>វ៉ុល (V)</strong></li>
                                <li>ខ្នាតដែលតូចជាងគឺ៖ <strong>មីលីវ៉ុល (mV)</strong></li>
                            </ul>
                            <div class="p-2.5 bg-white rounded-xl border border-slate-200 text-center font-mono text-xs font-bold text-indigo-800">
                                1V = 1000 mV
                            </div>
                        </div>
