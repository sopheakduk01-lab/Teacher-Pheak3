        // ==========================================
        // ANIMATION LOOP (CANVAS GRAPHICS)
        // ==========================================
        function resizeCanvas() {
            const rect = canvas.parentElement.getBoundingClientRect();
            canvas.width = rect.width;
            canvas.height = 320;
        }

        window.addEventListener('resize', () => {
            if (!document.getElementById('panel-simulation').classList.contains('hidden')) {
                resizeCanvas();
            }
        });

        function renderLoop() {
            const currentVal = parseFloat(document.getElementById('res-current-val').innerText) || 0;
            if (animActive && currentVal > 0) {
                electronOffset += 1.2 * (currentVal + 0.3);
            }

            const w = canvas.width;
            const h = canvas.height;
            ctx.clearRect(0, 0, w, h);

            // Subtle background grid
            ctx.strokeStyle = '#f1f5f9';
            ctx.lineWidth = 1;
            for (let x = 0; x < w; x += 30) {
                ctx.beginPath(); ctx.moveTo(x, 0); ctx.lineTo(x, h); ctx.stroke();
            }
            for (let y = 0; y < h; y += 30) {
                ctx.beginPath(); ctx.moveTo(0, y); ctx.lineTo(w, y); ctx.stroke();
            }

            if (simMode === 'conductor_test') {
                drawConductorTestCircuit(w, h, currentVal);
            } else {
                drawSeriesParallelCircuit(w, h, currentVal);
            }

            requestAnimationFrame(renderLoop);
        }

        // DRAW MODE 1: CONDUCTOR TEST
        function drawConductorTestCircuit(w, h, current) {
            const padX = 60;
            const topY = 60;
            const botY = 250;
            const rightX = w - padX;
            const leftX = padX;

            const isFlowing = current > 0;

            // 1. Draw Wires (Circuit Loop)
            ctx.strokeStyle = isFlowing ? '#0284c7' : '#94a3b8';
            ctx.lineWidth = 4;
            ctx.beginPath();
            // Top wire (Battery to Bulb)
            ctx.moveTo(leftX + 130, topY);
            ctx.lineTo(rightX, topY);
            // Right wire (Bulb to Switch)
            ctx.lineTo(rightX, botY);
            // Bottom wire right side (Switch to Test Material)
            ctx.lineTo(w / 2 + 70, botY);
            // Bottom wire left side (Test Material to Battery)
            ctx.moveTo(w / 2 - 70, botY);
            ctx.lineTo(leftX, botY);
            ctx.lineTo(leftX, topY);
            ctx.stroke();

            // 2. Draw Battery Pack (Left-Top)
            drawBatteryPack(leftX - 5, topY - 22, batteryCount);

            // 3. Draw Bulb (Top-Right)
            drawBulb(rightX, topY + 45, isFlowing, batteryCount);

            // 4. Draw Switch (Bottom-Right)
            drawSwitch(rightX - 80, botY, switchClosed);

            // 5. Draw Test Material (Bottom-Center between clips)
            drawTestMaterial(w / 2, botY, selectedMaterial, isFlowing);

            // 6. Draw Animated Electrons along wire if current > 0
            if (isFlowing) {
                drawFlowingElectrons(leftX, topY, rightX, botY, w / 2, electronOffset);
                drawDirectionArrows(leftX, topY, rightX, botY);
            }
        }

        // DRAW MODE 2: SERIES & PARALLEL CIRCUIT
        function drawSeriesParallelCircuit(w, h, current) {
            const leftX = 70;
            const rightX = w - 70;
            const midX = w / 2;
            const topY = 60;
            const botY = 250;

            const isFlowing = current > 0;

            // Draw Batteries (2 batteries = 3V)
            drawBatteryPack(leftX - 10, topY + 60, 2, true); // vertical battery

            // Main feeder wires
            ctx.strokeStyle = isFlowing ? '#0284c7' : '#94a3b8';
            ctx.lineWidth = 4;

            if (circuitType === 'series') {
                // Single Loop: Battery -> Switch -> Bulb 1 -> Bulb 2 -> Battery
                ctx.beginPath();
                ctx.moveTo(leftX, topY);
                ctx.lineTo(rightX, topY);
                ctx.lineTo(rightX, botY);
                ctx.lineTo(leftX, botY);
                ctx.lineTo(leftX, topY);
                ctx.stroke();

                drawSwitch(midX, botY, switchClosed);
                drawBulb(midX - 70, topY, isFlowing && !bulb1Broken, 2, "អំពូល ១", bulb1Broken);
                drawBulb(midX + 70, topY, isFlowing && !bulb2Broken, 2, "អំពូល ២", bulb2Broken);
            } else {
                // Parallel Loop: Two distinct branches
                // Branch 1 (top): y = 50
                // Branch 2 (mid): y = 150
                const branch1Y = 70;
                const branch2Y = 160;

                ctx.beginPath();
                // Outer loop
                ctx.moveTo(leftX, branch1Y);
                ctx.lineTo(rightX, branch1Y);
                ctx.lineTo(rightX, botY);
                ctx.lineTo(leftX, botY);
                ctx.lineTo(leftX, branch1Y);
                // Inner branch
                ctx.moveTo(leftX + 80, branch2Y);
                ctx.lineTo(rightX - 80, branch2Y);
                ctx.stroke();

                drawSwitch(midX, botY, switchClosed);
                drawBulb(midX, branch1Y, switchClosed && !bulb1Broken, 2, "អំពូល ១ (ខ្នែង)", bulb1Broken);
                drawBulb(midX, branch2Y, switchClosed && !bulb2Broken, 2, "អំពូល ២ (ខ្នែង)", bulb2Broken);
            }
        }

        // Helper Graphic: Battery
        function drawBatteryPack(x, y, count, vertical = false) {
            ctx.save();
            ctx.translate(x, y);

            for (let i = 0; i < count; i++) {
                const ox = vertical ? 0 : i * 42;
                const oy = vertical ? i * 42 : 0;

                // Battery Body
                ctx.fillStyle = '#1e293b';
                ctx.beginPath();
                ctx.roundRect ? ctx.roundRect(ox, oy, 36, 22, 4) : ctx.rect(ox, oy, 36, 22);
                ctx.fill();

                // Copper/Gold (+) terminal
                ctx.fillStyle = '#f59e0b';
                ctx.fillRect(ox + 34, oy + 5, 4, 12);

                // Label
                ctx.fillStyle = '#ffffff';
                ctx.font = 'bold 9px JetBrains Mono';
                ctx.textAlign = 'center';
                ctx.fillText("1.5V", ox + 18, oy + 14);

                // Polarity symbols
                ctx.fillStyle = '#38bdf8';
                ctx.fillText("-", ox + 6, oy + 14);
                ctx.fillStyle = '#f87171';
                ctx.fillText("+", ox + 30, oy + 14);
            }

            ctx.restore();
        }

        // Helper Graphic: Bulb
        function drawBulb(x, y, glowing, intensity = 1, label = "អំពូល", isBroken = false) {
            ctx.save();
            ctx.translate(x, y);

            if (isBroken) {
                // Detached/broken state
                ctx.strokeStyle = '#ef4444';
                ctx.lineWidth = 2;
                ctx.beginPath();
                ctx.arc(0, 0, 16, 0, Math.PI * 2);
                ctx.stroke();
                ctx.fillStyle = '#ef4444';
                ctx.font = 'bold 11px Kantumruy Pro';
                ctx.textAlign = 'center';
                ctx.fillText("✕ ដោះចេញ", 0, -22);
                ctx.restore();
                return;
            }

            // Glow effect
            if (glowing) {
                const glowR = 24 + intensity * 6;
                const grad = ctx.createRadialGradient(0, 0, 8, 0, 0, glowR);
                grad.addColorStop(0, 'rgba(251, 191, 36, 0.9)');
                grad.addColorStop(0.5, 'rgba(251, 191, 36, 0.4)');
                grad.addColorStop(1, 'rgba(251, 191, 36, 0)');
                ctx.fillStyle = grad;
                ctx.beginPath();
                ctx.arc(0, 0, glowR, 0, Math.PI * 2);
                ctx.fill();
            }

            // Glass bulb
            ctx.fillStyle = glowing ? '#fef08a' : '#f1f5f9';
            ctx.strokeStyle = glowing ? '#d97706' : '#64748b';
            ctx.lineWidth = 2;
            ctx.beginPath();
            ctx.arc(0, 0, 16, 0, Math.PI * 2);
            ctx.fill();
            ctx.stroke();

            // Filament
            ctx.strokeStyle = glowing ? '#b45309' : '#94a3b8';
            ctx.lineWidth = 1.5;
            ctx.beginPath();
            ctx.moveTo(-6, 8);
            ctx.lineTo(-3, -4);
            ctx.lineTo(3, -4);
            ctx.lineTo(6, 8);
            ctx.stroke();

            // Metallic Base
            ctx.fillStyle = '#64748b';
            ctx.fillRect(-7, 16, 14, 8);

            // Label
            ctx.fillStyle = glowing ? '#b45309' : '#64748b';
            ctx.font = 'bold 10px Kantumruy Pro';
            ctx.textAlign = 'center';
            ctx.fillText(label, 0, -20);

            ctx.restore();
        }

        // Helper Graphic: Switch
        function drawSwitch(x, y, closed) {
            ctx.save();
            ctx.translate(x, y);

            // Terminals
            ctx.fillStyle = '#334155';
            ctx.beginPath(); ctx.arc(-20, 0, 4, 0, Math.PI * 2); ctx.fill();
            ctx.beginPath(); ctx.arc(20, 0, 4, 0, Math.PI * 2); ctx.fill();

            // Lever
            ctx.strokeStyle = '#dc2626';
            ctx.lineWidth = 3.5;
            ctx.beginPath();
            ctx.moveTo(-20, 0);
            if (closed) {
                ctx.lineTo(20, 0);
            } else {
                ctx.lineTo(12, -18);
            }
            ctx.stroke();

            // Label
            ctx.fillStyle = '#475569';
            ctx.font = '10px Kantumruy Pro';
            ctx.textAlign = 'center';
            ctx.fillText(closed ? "កុងតាក់បិទ" : "កុងតាក់ចំហ", 0, 18);

            ctx.restore();
        }

        // Helper Graphic: Test Material
        function drawTestMaterial(x, y, matKey, isFlowing) {
            const mat = materialData[matKey];
            ctx.save();
