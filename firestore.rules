rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-\\s]+$');
    }
    
    function isOwnerOrAdmin(userId) {
      return isSignedIn() && (
        request.auth.uid == userId || 
        request.auth.token.email == 'sopheakduk01@gmail.com'
      );
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Teacher Academic Year Storage Collections
    match /teachers/{userId}/years/{yearId} {
      allow get: if isOwnerOrAdmin(userId);
      allow list: if isOwnerOrAdmin(userId);
      allow create: if isOwnerOrAdmin(userId) && isValidId(yearId);
      allow update: if isOwnerOrAdmin(userId) && isValidId(yearId);
      allow delete: if isOwnerOrAdmin(userId) && isValidId(yearId);
    }
  }
}
