rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    match /books/{bookId} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null;
    }

    match /borrowing_records/{recordId} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null;
    }
  }
}
